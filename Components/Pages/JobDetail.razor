<style>
    .job-title-header {
        text-align: center;
        padding: 35px 20px;
        background: rgba(255, 255, 255, 0.35);
        backdrop-filter: blur(20px);
        -webkit-backdrop-filter: blur(20px);
        border: 1px solid rgba(255, 255, 255, 0.6);
        border-radius: 16px;
        margin-bottom: 25px;
        box-shadow: 0 10px 30px rgba(22, 77, 22, 0.04);
    }

    .job-title-header h1 {
        font-size: 26px;
        font-weight: bold;
        color: #164d16;
        margin: 0;
    }

    .job-title-header p {
        font-size: 15px;
        color: #4a5f4a;
        margin: 8px 0 0 0;
        font-weight: 500;
    }

    .detail-container {
        display: flex;
        max-width: 1000px;
        margin: 0 auto;
        border-radius: 16px;
        overflow: hidden;
    }

    .left-panel {
        width: 38%;
        background: rgba(26, 92, 26, 0.04);
        padding: 30px 24px;
        border-right: 1px solid rgba(26, 92, 26, 0.08);
    }

    .right-panel {
        width: 62%;
        background: transparent;
        padding: 30px;
    }

    .section-title {
        color: #c0392b;
        font-weight: bold;
        font-size: 14px;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        border-bottom: 1px solid rgba(26, 92, 26, 0.1);
        padding-bottom: 6px;
        margin-bottom: 14px;
        margin-top: 25px;
    }

    .section-title:first-of-type {
        margin-top: 0;
    }

    .detail-row {
        display: flex;
        margin-bottom: 14px;
        align-items: flex-start;
    }

    .detail-label {
        font-weight: 600;
        width: 140px;
        font-size: 13.5px;
        color: #164d16;
        flex-shrink: 0;
    }

    .detail-value {
        font-size: 13.5px;
        color: #333;
    }

    .tag {
        background: rgba(0, 188, 212, 0.1);
        color: #00838f;
        border: 1px solid rgba(0, 188, 212, 0.2);
        padding: 5px 12px;
        border-radius: 6px;
        font-size: 12.5px;
        font-weight: 500;
        margin-right: 6px;
        margin-bottom: 8px;
        display: inline-block;
    }

    .back-btn {
        background: rgba(255, 255, 255, 0.6);
        border: 1px solid rgba(26, 92, 26, 0.15);
        color: #164d16;
        padding: 8px 18px;
        border-radius: 8px;
        text-decoration: none;
        font-size: 13.5px;
        font-weight: 500;
        display: inline-block;
        margin-bottom: 20px;
        box-shadow: 0 2px 6px rgba(0,0,0,0.02);
        transition: all 0.2s;
    }
    .back-btn:hover {
        background: #164d16;
        color: white;
    }

    .apply-btn {
        background: linear-gradient(135deg, #2d7a2d 0%, #1a5c1a 100%);
        color: white;
        padding: 11px 26px;
        border-radius: 8px;
        font-size: 14.5px;
        font-weight: bold;
        border: none;
        cursor: pointer;
        box-shadow: 0 4px 12px rgba(26, 92, 26, 0.2);
        transition: transform 0.2s;
    }
    .apply-btn:hover {
        transform: translateY(-2px);
    }

    .view-ad-btn {
        background: linear-gradient(135deg, #f39c12 0%, #d35400 100%);
        color: white;
        padding: 11px 26px;
        border-radius: 8px;
        font-size: 14.5px;
        font-weight: bold;
        border: none;
        cursor: pointer;
        box-shadow: 0 4px 12px rgba(243, 156, 18, 0.2);
        transition: transform 0.2s;
    }
    .view-ad-btn:hover {
        transform: translateY(-2px);
    }

    .panel-title {
        color: #1976d2;
        font-weight: bold;
        font-size: 15px;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        border-bottom: 1px solid rgba(26, 92, 26, 0.15);
        padding-bottom: 8px;
        margin-bottom: 16px;
    }
</style>

<div style="background: linear-gradient(135deg, #f4faf4 0%, #e8f5e8 100%); padding:50px 30px; min-height:100vh; position: relative; overflow: hidden;">
    <div style="position: absolute; top: -5%; left: 10%; width: 350px; height: 350px; background: rgba(45, 122, 45, 0.12); filter: blur(90px); border-radius: 50%;"></div>
    <div style="position: absolute; bottom: 5%; right: 10%; width: 400px; height: 400px; background: rgba(0, 188, 212, 0.1); filter: blur(100px); border-radius: 50%;"></div>

    <div style="position: relative; z-index: 2; max-width: 1000px; margin: 0 auto;">

        <a href="/jobs" class="back-btn">← Back to Listings</a>

        <div class="job-title-header">
            <h1>@Title</h1>
            <p>📍 @Department, PUNJAB</p>
        </div>

        <div style="background: rgba(255, 255, 255, 0.45); 
                    backdrop-filter: blur(25px); 
                    -webkit-backdrop-filter: blur(25px); 
                    border: 1px solid rgba(255, 255, 255, 0.7); 
                    border-radius: 16px; 
                    box-shadow: 0 15px 35px rgba(22, 77, 22, 0.05), inset 0 1px 0 rgba(255,255,255,0.5);
                    overflow: hidden;">
                    
            <div class="detail-container">

                <div class="left-panel">
                    <div class="panel-title">Job Summary</div>
                    <div class="detail-row">
                        <span class="detail-label">Division</span>
                        <span class="detail-value">@Division</span>
                    </div>
                    <div class="detail-row">
                        <span class="detail-label">District</span>
                        <span class="detail-value">@District</span>
                    </div>
                    <div class="detail-row">
                        <span class="detail-label">Industry</span>
                        <span class="detail-value">@Industry</span>
                    </div>
                    <div class="detail-row">
                        <span class="detail-label">Project</span>
                        <span class="detail-value">@Project</span>
                    </div>
                    <div class="detail-row">
                        <span class="detail-label">Total Positions</span>
                        <span class="detail-value">@Positions</span>
                    </div>
                    <div class="detail-row">
                        <span class="detail-label">Employment</span>
                        <span class="detail-value">@Employment</span>
                    </div>
                    <div class="detail-row">
                        <span class="detail-label">Role</span>
                        <span class="detail-value">@Role</span>
                    </div>
                    <div class="detail-row">
                        <span class="detail-label">Job Posted</span>
                        <span class="detail-value">@Posted</span>
                    </div>
                    <div class="detail-row">
                        <span class="detail-label">Level</span>
                        <span class="detail-value">@Level</span>
                    </div>
                    <div class="detail-row">
                        <span class="detail-label">Last Date</span>
                        <span class="detail-value" style="font-weight: 600; color: #c0392b;">@LastDate</span>
                    </div>

                    <div class="panel-title" style="margin-top:30px;">Requirements</div>
                    <div class="detail-row">
                        <span class="detail-label">Experience</span>
                        <span class="detail-value">@Experience</span>
                    </div>
                    <div class="detail-row">
                        <span class="detail-label">Gender</span>
                        <span class="detail-value">@Gender</span>
                    </div>
                    <div class="detail-row">
                        <span class="detail-label">Age Limit</span>
                        <span class="detail-value">@Age Years</span>
                    </div>
                </div>

                <div class="right-panel">
                    <div style="display:flex; align-items:center; justify-content:space-between; margin-bottom:20px; padding-bottom:15px; border-bottom:1px solid rgba(0,0,0,0.05);">
                        <div>
                            <div style="background: #00bcd4; color:white; padding:4px 10px; border-radius:4px; font-size:11px; font-weight: bold; display:inline-block; margin-bottom:5px;">
                                ACTIVE POSITION
                            </div>
                            <div style="font-weight:bold; font-size:16px; color: #164d16;">Overview Specifications</div>
                        </div>
                    </div>

                    <div class="section-title">Job Description</div>
                    <p style="font-size:14px; color:#333; line-height:1.7; margin-bottom: 0;">@Description</p>

                    <div class="section-title">Degree Level</div>
                    <span class="tag">@DegreeLevel</span>

                    <div class="section-title">Degree Area</div>
                    @foreach (var area in DegreeArea.Split(','))
                    {
                        if(!string.IsNullOrWhiteSpace(area))
                        {
                            <span class="tag">@area.Trim()</span>
                        }
                    }

                    <div class="section-title">Important Note</div>
                    <div style="background: rgba(25, 118, 210, 0.05); border-left: 4px solid #1976d2; padding: 12px 15px; border-radius: 0 8px 8px 0; margin-bottom: 25px;">
                        <p style="font-size:13.5px; color:#222; line-height:1.6; font-weight:bold; margin-bottom: 6px;">
                            Domicile is required for this position.
                        </p>
                        <p style="font-size:13px; color:#444; line-height:1.5; margin-bottom: 8px;">
                            For getting Domicile at home through the flagship initiative of the Government of Punjab, Call 1202 or download the Dastak Doorstep Delivery App now!
                        </p>
                        <p style="font-size:12.5px; color:#1976d2; font-weight: 500; margin-bottom: 0;">
                            Google Play Store | Apple App Store | Web Portal
                        </p>
                    </div>

                    <div style="display:flex; align-items:center; gap:15px; margin-top:20px;">
                        <button class="apply-btn" @onclick='() => NavigationManager.NavigateTo($"/apply/{JobId}")'>
                            Apply for this Job
                        </button>
                        <button class="view-ad-btn">
                            View Advertisement
                        </button>
                    </div>
                </div>

            </div>
        </div>
    </div>
</div>