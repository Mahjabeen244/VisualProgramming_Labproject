@page "/login"
@rendermode InteractiveServer
<PageTitle>Login - Punjab Jobs Online</PageTitle>

<style>
    .auth-wrapper {
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        background: linear-gradient(135deg, #e8f5e8 0%, #f0f8f0 100%);
        padding: 30px 20px;
    }

    .auth-card {
        background: white;
        border-radius: 8px;
        box-shadow: 0 10px 40px rgba(0,0,0,0.15);
        width: 100%;
        max-width: 500px;
        overflow: hidden;
    }

    .auth-header {
        background: #2d7a2d;
        color: white;
        padding: 20px 30px;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .auth-header h4 {
        margin: 0;
        font-size: 20px;
        font-weight: bold;
    }

    .close-btn {
        background: white;
        color: #2d7a2d;
        border: none;
        border-radius: 50%;
        width: 28px;
        height: 28px;
        font-weight: bold;
        cursor: pointer;
        font-size: 14px;
    }

    .auth-body {
        padding: 30px;
    }

    .form-row {
        display: flex;
        align-items: center;
        margin-bottom: 20px;
        gap: 15px;
    }

    .form-row label {
        width: 160px;
        font-size: 14px;
        color: #333;
        flex-shrink: 0;
    }

    .form-row input {
        flex: 1;
        padding: 10px 14px;
        border: 1px solid #ddd;
        border-radius: 4px;
        font-size: 14px;
        outline: none;
    }

    .form-row input:focus {
        border-color: #2d7a2d;
        box-shadow: 0 0 0 2px rgba(45,122,45,0.1);
    }

    .captcha-box {
        background: #2d7a2d;
        color: white;
        padding: 12px 20px;
        border-radius: 4px;
        font-size: 20px;
        font-weight: bold;
        letter-spacing: 8px;
        flex: 1;
        text-align: center;
        font-family: monospace;
        user-select: none;
    }

    .refresh-btn {
        background: #2d7a2d;
        color: white;
        border: none;
        border-radius: 4px;
        width: 40px;
        height: 44px;
        cursor: pointer;
        font-size: 16px;
    }

    .auth-footer {
        padding: 15px 30px 25px 30px;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .btn-green {
        background: #2d7a2d;
        color: white;
        border: none;
        padding: 10px 25px;
        border-radius: 4px;
        font-size: 14px;
        cursor: pointer;
        font-weight: bold;
        text-decoration: none;
        display: inline-block;
    }

    .btn-green:hover { background: #1f5c1f; }

    .success-msg {
        background: #d4edda;
        color: #155724;
        padding: 12px 15px;
        border-radius: 4px;
        margin-bottom: 15px;
        font-size: 14px;
        border: 1px solid #c3e6cb;
    }

    .error-msg {
        background: #f8d7da;
        color: #721c24;
        padding: 12px 15px;
        border-radius: 4px;
        margin-bottom: 15px;
        font-size: 14px;
        border: 1px solid #f5c6cb;
    }
</style>

@code {
    private string Email = "";
    private string Password = "";
    private string CaptchaInput = "";
    private string CaptchaCode = "";
    private string Message = "";
    private bool IsSuccess = false;
    private bool IsLoading = false;

    protected override void OnInitialized()
    {
        GenerateCaptcha();
    }

    private void GenerateCaptcha()
    {
        var chars = "ABCDEFGHJKLMNPQRSTUVWXYZ23456789";
        var random = new Random();
        CaptchaCode = new string(Enumerable.Range(0, 6)
            .Select(_ => chars[random.Next(chars.Length)]).ToArray());
    }

    private async Task HandleLogin()
    {
        Message = "";

        if (string.IsNullOrEmpty(Email))
        { Message = "Please enter email address."; return; }

        if (string.IsNullOrEmpty(Password))
        { Message = "Please enter password."; return; }

        if (CaptchaInput.ToUpper() != CaptchaCode)
        { Message = "Invalid captcha. Please try again."; GenerateCaptcha(); CaptchaInput = ""; return; }

        IsLoading = true;
        await Task.Delay(1000);
        IsLoading = false;
        IsSuccess = true;
        Message = "Login successful! Welcome back.";
    }
}

<div class="auth-wrapper">
    <div class="auth-card">
        <div class="auth-header">
            <h4>Login</h4>
            <a href="/"><button class="close-btn">✕</button></a>
        </div>

        <div class="auth-body">
            @if (!string.IsNullOrEmpty(Message))
            {
                <div class="@(IsSuccess ? "success-msg" : "error-msg")">
                    @Message
                </div>
            }

            @if (!IsSuccess)
            {
                <div class="form-row">
                    <label>Email Address</label>
                    <input type="email" placeholder="Email" @bind="Email" />
                </div>

                <div class="form-row">
                    <label>Password</label>
                    <input type="password" placeholder="Password" @bind="Password" />
                </div>

                <div class="form-row">
                    <label></label>
                    <div class="captcha-box">@CaptchaCode</div>
                    <button class="refresh-btn" @onclick="GenerateCaptcha">🔄</button>
                </div>

                <div class="form-row">
                    <label></label>
                    <input type="text" placeholder="Enter Captcha" @bind="CaptchaInput" />
                </div>
            }
            else
            {
                <div style="text-align:center; padding:20px;">
                    <div style="font-size:50px;">✅</div>
                    <h5 style="color:#2d7a2d; margin-top:10px;">Login Successful!</h5>
                    <p style="color:#666; font-size:14px;">Welcome back to Punjab Jobs Online.</p>
                    <a href="/">
                        <button style="background:#2d7a2d; color:white; border:none; padding:10px 25px; border-radius:4px; cursor:pointer; margin-top:10px;">
                            Go to Home
                        </button>
                    </a>
                </div>
            }
        </div>

        @if (!IsSuccess)
        {
            <div class="auth-footer">
                <div style="display:flex; gap:10px;">
                    <a href="/register" class="btn-green">Register</a>
                    <button class="btn-green" style="background:#2d7a2d;">Forget Password</button>
                </div>
                <button class="btn-green" @onclick="HandleLogin" disabled="@IsLoading">
                    @(IsLoading ? "Logging in..." : "Login")
                </button>
            </div>
        }
    </div>
</div>