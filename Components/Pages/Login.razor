@page "/login"
@rendermode InteractiveServer
<PageTitle>Login - Punjab Jobs Online</PageTitle>

<style>
    /* Full-Screen Ambient Background Layer */
    .auth-wrapper {
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        background: linear-gradient(135deg, #407740 0%, #e6f2e6 100%);
        padding: 40px 20px;
        position: relative;
        overflow: hidden;
        font-family: system-ui, -apple-system, sans-serif;
    }

    /* Ambient background blur orbs matching the application setup */
    .bg-glow-1 {
        position: absolute;
        top: -10%;
        left: 15%;
        width: 450px;
        height: 450px;
        background: rgba(45, 122, 45, 0.22);
        filter: blur(100px);
        border-radius: 50%;
        z-index: 1;
    }

    .bg-glow-2 {
        position: absolute;
        bottom: -5%;
        right: 15%;
        width: 450px;
        height: 450px;
        background: rgba(139, 195, 74, 0.25);
        filter: blur(110px);
        border-radius: 50%;
        z-index: 1;
    }

    /* Pure White Glassmorphism Content Card */
    .auth-card {
        background: rgba(255, 255, 255, 0.78) !important;
        backdrop-filter: blur(25px);
        -webkit-backdrop-filter: blur(25px);
        border: 1px solid rgba(255, 255, 255, 0.85);
        border-radius: 24px;
        width: 100%;
        max-width: 520px;
        overflow: hidden; /* Crucial: Prevents the green header from clipping past rounded corners */
        box-shadow: 0 20px 50px rgba(0, 0, 0, 0.06), inset 0 1px 0 rgba(255, 255, 255, 0.8);
        position: relative;
        z-index: 2;
    }

    /* Solid Brand Green Top Bar Header */
    .auth-header {
        background: #2d7a2d !important; /* Forces the green bar appearance */
        padding: 24px 35px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        border-bottom: 1px solid rgba(255, 255, 255, 0.1);
    }

    .auth-header h4 {
        margin: 0;
        color: #ffffff !important;
        font-size: 22px;
        font-weight: 700;
        letter-spacing: 0.3px;
    }

    .close-btn {
        background: rgba(255, 255, 255, 0.2);
        color: white;
        border: 1px solid rgba(255, 255, 255, 0.3);
        border-radius: 50%;
        width: 32px;
        height: 32px;
        font-weight: bold;
        cursor: pointer;
        font-size: 13px;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: all 0.2s;
    }

    .close-btn:hover {
        background: white;
        color: #2d7a2d;
    }

    .auth-body {
        padding: 35px 35px 20px 35px;
    }

    /* Modern Flex Form Architecture */
    .form-row {
        display: flex;
        flex-direction: column;
        margin-bottom: 20px;
        gap: 8px;
    }

    .form-row label {
        font-size: 14.5px;
        font-weight: 600;
        color: #2c3e2c;
    }

    /* Glass Input Fields */
    .form-row input {
        width: 100%;
        padding: 12px 16px;
        background: rgba(255, 255, 255, 0.85);
        border: 1px solid rgba(0, 0, 0, 0.12);
        border-radius: 10px;
        font-size: 14.5px;
        color: #222;
        outline: none;
        transition: all 0.25s ease;
    }

    .form-row input:focus {
        background: #ffffff;
        border-color: #2d7a2d;
        box-shadow: 0 0 0 4px rgba(45, 122, 45, 0.15);
    }

    /* Captcha Component Matrix Layout */
    .captcha-container {
        display: flex;
        gap: 12px;
        align-items: center;
        width: 100%;
    }

    .captcha-box {
        background: #2d7a2d;
        color: white;
        height: 48px;
        border-radius: 10px;
        font-size: 22px;
        font-weight: 700;
        letter-spacing: 6px;
        flex: 1;
        display: flex;
        align-items: center;
        justify-content: center;
        font-family: 'Courier New', monospace;
        user-select: none;
        box-shadow: 0 4px 12px rgba(45, 122, 45, 0.15);
    }

    .refresh-btn {
        background: rgba(255, 255, 255, 0.9);
        border: 1px solid rgba(0, 0, 0, 0.12);
        color: #2d7a2d;
        border-radius: 10px;
        width: 50px;
        height: 48px;
        cursor: pointer;
        font-size: 18px;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: all 0.2s;
    }

    .refresh-btn:hover {
        background: #ffffff;
        border-color: #2d7a2d;
        transform: rotate(45deg);
    }

    /* Footer Navigation Area */
    .auth-footer {
        padding: 10px 35px 35px 35px;
        display: flex;
        flex-direction: column;
        gap: 15px;
    }

    .footer-actions-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 12px;
        flex-wrap: wrap;
    }

    .secondary-links {
        display: flex;
        gap: 10px;
        width: 100%;
    }

    /* Button Variations matching system guidelines */
    .btn-green {
        background: #2d7a2d;
        color: white;
        border: none;
        padding: 14px 30px;
        border-radius: 10px;
        font-size: 15px;
        cursor: pointer;
        font-weight: 700;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        box-shadow: 0 5px 15px rgba(45, 122, 45, 0.2);
        transition: all 0.25s ease;
    }

    .btn-green:hover:not(:disabled) {
        background: #1f5c1f;
        transform: translateY(-2px);
    }

    .btn-slate {
        background: #556b55;
        color: white;
        border: none;
        padding: 11px 20px;
        border-radius: 10px;
        font-size: 14px;
        cursor: pointer;
        font-weight: 700;
        text-decoration: none;
        flex: 1;
        text-align: center;
        transition: background 0.2s;
    }

    .btn-slate:hover {
        background: #425442;
    }

    .btn-green:disabled {
        opacity: 0.6;
        cursor: not-allowed;
    }

    /* Status Notifications */
    .success-msg {
        background: rgba(212, 237, 218, 0.9);
        color: #155724;
        padding: 14px 18px;
        border-radius: 12px;
        margin-bottom: 20px;
        font-size: 14px;
        font-weight: 600;
        border: 1px solid #c3e6cb;
    }

    .error-msg {
        background: rgba(248, 215, 218, 0.9);
        color: #721c24;
        padding: 14px 18px;
        border-radius: 12px;
        margin-bottom: 20px;
        font-size: 14px;
        font-weight: 600;
        border: 1px solid #f5c6cb;
    }
</style>

<div class="auth-wrapper">
    <div class="bg-glow-1"></div>
    <div class="bg-glow-2"></div>

    <div class="auth-card">
        <div class="auth-header">
            <h4>Login</h4>
            <a href="/" style="text-decoration: none;"><button type="button" class="close-btn">✕</button></a>
        </div>

        <div class="auth-body">
            @if (!string.IsNullOrEmpty(Message))
            {
                <div class="@(IsSuccess ? "success-msg" : "error-msg")">
                    @Message
                </div>
            }

            @if (!IsSuccess)
            {
                <div class="form-row">
                    <label>Email Address</label>
                    <input type="email" placeholder="Enter your email address" @bind="Email" />
                </div>

                <div class="form-row">
                    <label>Password</label>
                    <input type="password" placeholder="Enter your password" @bind="Password" />
                </div>

                <div class="form-row">
                    <label>Verification Code</label>
                    <div class="captcha-container">
                        <div class="captcha-box">@CaptchaCode</div>
                        <button type="button" class="refresh-btn" @onclick="GenerateCaptcha">🔄</button>
                    </div>
                </div>

                <div class="form-row" style="margin-bottom: 10px;">
                    <input type="text" placeholder="Enter verification code shown above" @bind="CaptchaInput" />
                </div>
            }
            else
            {
                <div style="text-align:center; padding: 20px 10px 10px 10px;">
                    <div style="font-size:55px; margin-bottom: 10px;">✨</div>
                    <h5 style="color:#2d7a2d; font-weight:800; font-size:18px; margin: 0 0 8px 0;">Welcome Back!</h5>
                    <p style="color:#333; font-size:14.5px; font-weight:500; margin-bottom: 20px;">You have logged into your dashboard space successfully.</p>
                    <a href="/" style="text-decoration: none;">
                        <button type="button" class="btn-green" style="padding: 12px 30px; width: 100%;">
                            Proceed to Home Dashboard
                        </button>
                    </a>
                </div>
            }
        </div>

        @if (!IsSuccess)
        {
            <div class="auth-footer">
                <button type="button" class="btn-green" style="width: 100%; padding: 13px;" @onclick="HandleLogin" disabled="@IsLoading">
                    @(IsLoading ? "Authenticating Secure Session..." : "Secure Login")
                </button>
                
                <div class="footer-actions-row">
                    <div class="secondary-links">
                        <a href="/register" class="btn-slate">Register</a>
                        <button type="button" class="btn-slate">Forgot Password</button>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

@code {
    private string Email = "";
    private string Password = "";
    private string CaptchaInput = "";
    private string CaptchaCode = "";
    private string Message = "";
    private bool IsSuccess = false;
    private bool IsLoading = false;

    protected override void OnInitialized()
    {
        GenerateCaptcha();
    }

    private void GenerateCaptcha()
    {
        var chars = "ABCDEFGHJKLMNPQRSTUVWXYZ23456789";
        var random = new Random();
        CaptchaCode = new string(Enumerable.Range(0, 6)
            .Select(_ => chars[random.Next(chars.Length)]).ToArray());
    }

    private async Task HandleLogin()
    {
        Message = "";

        if (string.IsNullOrEmpty(Email))
        { Message = "⚠️ Please enter your email address."; return; }

        if (string.IsNullOrEmpty(Password))
        { Message = "⚠️ Please enter your account password."; return; }

        if (string.IsNullOrEmpty(CaptchaInput) || CaptchaInput.ToUpper() != CaptchaCode)
        { 
            Message = "⚠️ Invalid verification code. Please check and retry."; 
            GenerateCaptcha(); 
            CaptchaInput = ""; 
            return; 
        }

        IsLoading = true;
        await Task.Delay(1200);
        IsLoading = false;
        IsSuccess = true;
        Message = "Success! Initializing user session environment...";
    }
}