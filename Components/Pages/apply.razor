@page "/apply/{JobId:int}"
@rendermode InteractiveServer
<PageTitle>Apply for Job - Punjab Jobs Online</PageTitle>

<style>
    /* Full-Screen Ambient Background Layer */
    .apply-wrapper {
        padding: 60px 20px;
        background: linear-gradient(135deg, #407740 0%, #e6f2e6 100%);
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        position: relative;
        overflow: hidden;
        font-family: system-ui, -apple-system, sans-serif;
    }

    /* Ambient background blur orbs that shine through the white glass card */
    .bg-glow-1 {
        position: absolute;
        top: -10%;
        left: 10%;
        width: 450px;
        height: 450px;
        background: rgba(45, 122, 45, 0.22);
        filter: blur(100px);
        border-radius: 50%;
        z-index: 1;
    }

    .bg-glow-2 {
        position: absolute;
        bottom: -5%;
        right: 10%;
        width: 500px;
        height: 500px;
        background: rgba(139, 195, 74, 0.25);
        filter: blur(120px);
        border-radius: 50%;
        z-index: 1;
    }

    /* Pure White Glassmorphism Content Card */
    .apply-card {
        background: rgba(255, 255, 255, 0.78) !important;
        backdrop-filter: blur(25px);
        -webkit-backdrop-filter: blur(25px);
        border: 1px solid rgba(255, 255, 255, 0.85);
        border-radius: 24px;
        padding: 40px;
        width: 100%;
        max-width: 760px;
        margin: 0 auto;
        box-shadow: 0 20px 50px rgba(0, 0, 0, 0.06), inset 0 1px 0 rgba(255, 255, 255, 0.8);
        position: relative;
        z-index: 2;
    }

    /* Title Layout Styles */
    .apply-title {
        color: #1b5e20;
        font-size: 26px;
        font-weight: 800;
        margin-bottom: 6px;
        letter-spacing: -0.5px;
    }

    .apply-subtitle {
        color: #2c3e2c;
        font-size: 15px;
        font-weight: 600;
        margin-bottom: 30px;
        padding-bottom: 20px;
        border-bottom: 1px solid rgba(16, 73, 16, 0.12);
    }

    .form-group {
        margin-bottom: 22px;
    }

    .form-group label {
        display: block;
        font-size: 14px;
        font-weight: 700;
        color: #1c331c;
        margin-bottom: 8px;
    }

    /* Glass Form Field Components */
    .form-group input,
    .form-group select,
    .form-group textarea {
        width: 100%;
        padding: 12px 16px;
        background: rgba(255, 255, 255, 0.85);
        border: 1px solid rgba(0, 0, 0, 0.12);
        border-radius: 12px;
        font-size: 14.5px;
        color: #222;
        outline: none;
        transition: all 0.25s ease;
    }

    .form-group input::placeholder,
    .form-group textarea::placeholder {
        color: #888;
    }

    .form-group input:focus,
    .form-group select:focus,
    .form-group textarea:focus {
        background: #ffffff;
        border-color: #2d7a2d;
        box-shadow: 0 0 0 4px rgba(45, 122, 45, 0.15);
    }

    /* Form Grid Adjustment */
    .form-row {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 20px;
    }

    @@media (max-width: 600px) {
        .form-row {
            grid-template-columns: 1fr;
            gap: 0;
        }
    }

    /* Custom Branded File Field */
    .file-input-wrapper {
        position: relative;
        display: inline-block;
        width: 100%;
    }

    .file-input-wrapper input[type="file"] {
        background: rgba(255, 255, 255, 0.6);
        cursor: pointer;
        font-size: 13.5px;
    }

    /* Premium Submission Action Button */
    .submit-btn {
        background: #2d7a2d;
        color: white;
        border: none;
        padding: 14px 35px;
        border-radius: 12px;
        font-size: 16px;
        font-weight: 700;
        cursor: pointer;
        width: 100%;
        margin-top: 15px;
        box-shadow: 0 5px 15px rgba(45, 122, 45, 0.2);
        transition: all 0.25s ease;
    }

    .submit-btn:hover:not(:disabled) {
        background: #1f5c1f;
        transform: translateY(-2px);
        box-shadow: 0 8px 20px rgba(31, 92, 31, 0.25);
    }

    .submit-btn:disabled {
        opacity: 0.6;
        cursor: not-allowed;
    }

    .back-link {
        color: #556b55;
        font-size: 14px;
        font-weight: 600;
        text-decoration: none;
        transition: color 0.2s;
    }

    .back-link:hover {
        color: #2d7a2d;
    }

    /* Status Notifications */
    .error-alert {
        background: rgba(248, 215, 218, 0.9);
        color: #721c24;
        padding: 14px 18px;
        border-radius: 12px;
        margin-bottom: 24px;
        font-size: 14px;
        font-weight: 600;
        border: 1px solid #f5c6cb;
    }

    .success-box {
        text-align: center;
        padding: 20px 10px;
    }
</style>

<div class="apply-wrapper">
    <div class="bg-glow-1"></div>
    <div class="bg-glow-2"></div>

    <div class="apply-card">
        @if (!IsSuccess)
        {
            <div class="apply-title">Apply for Job</div>
            <div class="apply-subtitle">📍 @JobTitle</div>

            @if (!string.IsNullOrEmpty(Message))
            {
                <div class="error-alert">
                    @Message
                </div>
            }

            <div class="form-row">
                <div class="form-group">
                    <label>Full Name *</label>
                    <input type="text" placeholder="Enter full name" @bind="FullName" />
                </div>
                <div class="form-group">
                    <label>Email Address *</label>
                    <input type="email" placeholder="Enter email address" @bind="Email" />
                </div>
            </div>

            <div class="form-row">
                <div class="form-group">
                    <label>Phone Number *</label>
                    <input type="text" placeholder="03XX-XXXXXXX" @bind="Phone" />
                </div>
                <div class="form-group">
                    <label>CNIC Number *</label>
                    <input type="text" placeholder="XXXXX-XXXXXXX-X" @bind="CNIC" />
                </div>
            </div>

            <div class="form-row">
                <div class="form-group">
                    <label>Education Level *</label>
                    <select @bind="Education">
                        <option value="">Select Education</option>
                        <option>Matriculation</option>
                        <option>Intermediate</option>
                        <option>Bachelors</option>
                        <option>Masters</option>
                        <option>MPhil/PhD</option>
                    </select>
                </div>
                <div class="form-group">
                    <label>Years of Experience</label>
                    <select @bind="Experience">
                        <option value="">Select Experience</option>
                        <option>Fresh Graduate</option>
                        <option>1-2 Years</option>
                        <option>3-5 Years</option>
                        <option>5-10 Years</option>
                        <option>10+ Years</option>
                    </select>
                </div>
            </div>

            <div class="form-group">
                <label>Cover Letter</label>
                <textarea placeholder="Write a brief cover letter introduction..." @bind="CoverLetter" style="height:110px; resize:vertical;"></textarea>
            </div>

            <div class="form-group">
                <label>Upload CV (PDF format)</label>
                <div class="file-input-wrapper">
                    <input type="file" accept=".pdf" />
                </div>
            </div>

            <button type="button" class="submit-btn" @onclick="HandleApply" disabled="@IsLoading">
                @(IsLoading ? "Processing Secure Submission..." : "Submit Application")
            </button>

            <div style="text-align:center; margin-top:20px;">
                <a href="/jobs" class="back-link">← Return to Job Listings</a>
            </div>
        }
        else
        {
            <div class="success-box">
                <div style="font-size:65px; margin-bottom: 15px;">✨</div>
                <h4 style="color:#2d7a2d; font-weight:800; margin-bottom:12px;">Application Submitted!</h4>
                <p style="color:#333; font-size:15px; font-weight:500; line-height:1.6; margin-bottom:30px; padding: 0 10px;">
                    Your professional dossier for <strong>@JobTitle</strong> has been safely uploaded and added into the system repository database.
                </p>
                <div style="display:flex; gap:15px; flex-wrap:wrap; justify-content:center;">
                    <a href="/jobs" style="text-decoration:none; flex: 1; min-width: 160px;">
                        <button type="button" style="background:#2d7a2d; color:white; border:none; padding:12px 25px; border-radius:12px; font-weight:700; font-size:14.5px; cursor:pointer; width:100%; box-shadow:0 4px 12px rgba(45,122,45,0.2);">
                            Browse Jobs
                        </button>
                    </a>
                    <a href="/" style="text-decoration:none; flex: 1; min-width: 160px;">
                        <button type="button" style="background:#556b55; color:white; border:none; padding:12px 25px; border-radius:12px; font-weight:700; font-size:14.5px; cursor:pointer; width:100%;">
                            Go to Home
                        </button>
                    </a>
                </div>
            </div>
        }
    </div>
</div>

@code {
    [Parameter] public int JobId { get; set; }

    private string FullName = "";
    private string Email = "";
    private string Phone = "";
    private string CNIC = "";
    private string Education = "";
    private string Experience = "";
    private string CoverLetter = "";
    private string Message = "";
    private bool IsSuccess = false;
    private bool IsLoading = false;

    private string JobTitle => JobId switch
    {
        1 => "Assistant Director (Research, Data & Evaluation)",
        2 => "Deputy Director (Admin & Finance)",
        3 => "Assistant Director (Administration)",
        4 => "Quality Assurance Programmer",
        5 => "Database Administrator",
        _ => "Job Position"
    };

    private async Task HandleApply()
    {
        Message = "";

        if (string.IsNullOrEmpty(FullName))
        { Message = "⚠️ Please enter your full name."; return; }

        if (string.IsNullOrEmpty(Email) || !Email.Contains("@"))
        { Message = "⚠️ Please enter a valid email address."; return; }

        if (string.IsNullOrEmpty(Phone))
        { Message = "⚠️ Please enter your phone number."; return; }

        if (string.IsNullOrEmpty(CNIC))
        { Message = "⚠️ Please enter your CNIC number."; return; }

        if (string.IsNullOrEmpty(Education))
        { Message = "⚠️ Please select your education level."; return; }

        IsLoading = true;
        await Task.Delay(1500);
        IsLoading = false;
        IsSuccess = true;
    }
}