@page "/apply/{JobId:int}"
@rendermode InteractiveServer
<PageTitle>Apply for Job - Punjab Jobs Online</PageTitle>

<style>
    .apply-wrapper {
        padding: 40px;
        background: #f5f5f5;
        min-height: 100vh;
    }

    .apply-card {
        background: white;
        border-radius: 8px;
        padding: 35px;
        max-width: 700px;
        margin: 0 auto;
        box-shadow: 0 2px 15px rgba(0,0,0,0.08);
    }

    .apply-title {
        color: #1a5c1a;
        font-size: 22px;
        font-weight: bold;
        margin-bottom: 5px;
    }
    .apply-subtitle {
        color: #666;
        font-size: 14px;
        margin-bottom: 25px;
        padding-bottom: 20px;
        border-bottom: 1px solid #eee;
    }

     .form-group {
        margin-bottom: 20px;
    }

    .form-group label {
        display: block;
        font-size: 14px;
        font-weight: bold;
        color: #333;
        margin-bottom: 6px;
    }

    .form-group input,
    .form-group select,
    .form-group textarea {
        width: 100%;
        padding: 10px 14px;
        border: 1px solid #ddd;
        border-radius: 4px;
        font-size: 14px;
        outline: none;
    }
    .form-group input:focus,
    .form-group textarea:focus {
        border-color: #2d7a2d;
        box-shadow: 0 0 0 2px rgba(45,122,45,0.1);
    }

    .form-row {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 15px;
    }

    .submit-btn {
        background: #2d7a2d;
        color: white;
        border: none;
        padding: 12px 35px;
        border-radius: 4px;
        font-size: 15px;
        font-weight: bold;
        cursor: pointer;
        width: 100%;
        margin-top: 10px;
    }

    .submit-btn:hover { background: #1f5c1f; }

    .success-box {
        text-align: center;
        padding: 40px 20px;
    }
</style>