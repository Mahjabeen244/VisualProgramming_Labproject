@page "/apply/{JobId:int}"
@rendermode InteractiveServer
<PageTitle>Apply for Job - Punjab Jobs Online</PageTitle>

<style>
    .apply-wrapper {
        padding: 40px;
        background: #f5f5f5;
        min-height: 100vh;
    }

    .apply-card {
        background: white;
        border-radius: 8px;
        padding: 35px;
        max-width: 700px;
        margin: 0 auto;
        box-shadow: 0 2px 15px rgba(0,0,0,0.08);
    }

    .apply-title {
        color: #1a5c1a;
        font-size: 22px;
        font-weight: bold;
        margin-bottom: 5px;
    }