    private string SelectedDepartment = "";
    private string SelectedLocation = "";
    private List<string> SelectedContracts = new();
    private string SelectedCareerLevel = "";
    private int CurrentPage = 1;
    private int PageSize = 10;
    private int TotalPages => (int)Math.Ceiling((double)FilteredJobs.Count / PageSize);
    private List<JobItem> PagedJobs => FilteredJobs.Skip((CurrentPage - 1) * PageSize).Take(PageSize).ToList();

