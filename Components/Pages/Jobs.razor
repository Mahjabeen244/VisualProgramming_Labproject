@page "/jobs"
@rendermode InteractiveServer
<PageTitle>Jobs - Punjab Jobs Online</PageTitle>

<style>
    .jobs-wrapper {
        padding: 30px 20px;
        background: #f5f5f5;
        min-height: 100vh;
    }

    .jobs-layout {
        display: flex;
        gap: 20px;
        max-width: 1200px;
        margin: 0 auto;
    }

    .filter-panel {
        width: 260px;
        flex-shrink: 0;
    }

    .filter-box {
        background: #efefef;
        border-radius: 4px;
        padding: 20px;
    }

    .filter-title {
        color: #1a6bbf;
        font-weight: bold;
        font-size: 17px;
        border-bottom: 2px solid #ccc;
        padding-bottom: 10px;
        margin-bottom: 15px;
    }

    .filter-section-title {
        color: #1a6bbf;
        font-weight: bold;
        font-size: 13px;
        margin-top: 18px;
        margin-bottom: 8px;
    }

    .clear-link {
        color: #1a6bbf;
        font-size: 12px;
        cursor: pointer;
        display: block;
        margin-top: 4px;
        background: none;
        border: none;
        padding: 0;
        text-decoration: none;
    }

    .jobs-panel {
        flex: 1;
        background: white;
        border-radius: 4px;
        padding: 20px;
        border: 1px solid #e0e0e0;
    }

    .jobs-table {
        width: 100%;
        border-collapse: collapse;
        margin-top: 15px;
    }

    .jobs-table th {
        background: #d6d6d6;
        padding: 12px 10px;
        text-align: left;
        font-size: 13px;
        font-weight: bold;
        color: #333;
    }

    .jobs-table td {
        padding: 12px 10px;
        font-size: 13px;
        border-bottom: 1px solid #eee;
        vertical-align: middle;
    }

    .jobs-table tr:hover { background: #f9f9f9; }

    .job-title-link {
        color: #1a6bbf;
        font-weight: bold;
        text-decoration: none;
        cursor: pointer;
    }

    .job-title-link:hover { text-decoration: underline; }

    .apply-btn {
        background: #2d7a2d;
        color: white;
        padding: 6px 16px;
        border-radius: 3px;
        border: none;
        font-size: 13px;
        cursor: pointer;
        white-space: nowrap;
    }

    .apply-btn:hover { background: #1f5c1f; }

    .search-btn {
        background: #2d7a2d;
        color: white;
        padding: 8px 20px;
        border: none;
        border-radius: 3px;
        cursor: pointer;
        font-size: 14px;
        width: 100%;
        margin-top: 12px;
    }

    .page-btn {
        padding: 5px 10px;
        border: 1px solid #ddd;
        border-radius: 3px;
        cursor: pointer;
        background: white;
        font-size: 13px;
    }

    .page-btn.active {
        background: #2d7a2d;
        color: white;
        border-color: #2d7a2d;
    }

    .page-btn:disabled {
        opacity: 0.5;
        cursor: not-allowed;
    }
</style>

@code {
