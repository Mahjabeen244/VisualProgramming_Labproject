            new JobItem { Id=14, Title="Deputy Director (Admin/HR)", Department="Directorate General Monitoring and Evaluation", Project="DG M&E Planning and Development Board", Province="PUNJAB", LastDate="10-Jun-2026", ContractType="Full Time", CareerLevel="Management" },
            new JobItem { Id=15, Title="Deputy Director (Project Management)", Department="Directorate General Monitoring and Evaluation", Project="DG M&E Planning and Development Board", Province="PUNJAB", LastDate="10-Jun-2026", ContractType="Full Time", CareerLevel="Management" },
