@page "/jobs"
@rendermode InteractiveServer
<PageTitle>Jobs - Punjab Jobs Online</PageTitle>

<style>
    /* Premium Radiant Mint Soft Blend Background */
    .jobs-wrapper {
        background: linear-gradient(135deg, #eef9ee 0%, #d8edd8 100%);
        padding: 40px 20px;
        min-height: 100vh;
        font-family: system-ui, -apple-system, sans-serif;
    }

    .jobs-layout {
        display: flex;
        gap: 25px;
        max-width: 1250px;
        margin: 0 auto;
        align-items: flex-start;
    }

    /* Left Sidebar Glassmorphism Architecture */
    .filter-panel {
        width: 300px;
        flex-shrink: 0;
    }

    .filter-box {
        background: rgba(255, 255, 255, 0.45);
        backdrop-filter: blur(20px);
        -webkit-backdrop-filter: blur(20px);
        border: 1px solid rgba(255, 255, 255, 0.75);
        border-radius: 16px;
        padding: 24px;
        box-shadow: 0 10px 30px rgba(16, 73, 16, 0.05);
    }

    .filter-title {
        color: #0b2e0b;
        font-weight: 800;
        font-size: 19px;
        border-bottom: 2px solid rgba(16, 73, 16, 0.15);
        padding-bottom: 12px;
        margin-bottom: 20px;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    .filter-section-title {
        color: #114711;
        font-weight: 800;
        font-size: 14px;
        margin-top: 24px;
        margin-bottom: 10px;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    /* Glass styled Form Inputs */
    .glass-input, .glass-select {
        width: 100%;
        background: rgba(255, 255, 255, 0.65) !important;
        border: 1px solid rgba(16, 73, 16, 0.2) !important;
        border-radius: 8px !important;
        padding: 10px 12px;
        color: #111 !important;
        font-weight: 500;
        outline: none;
        transition: all 0.2s ease;
    }
    
    .glass-input:focus, .glass-select:focus {
        background: rgba(255, 255, 255, 0.9) !important;
        border-color: #1b5e20 !important;
        box-shadow: 0 0 0 3px rgba(27, 94, 32, 0.15);
    }

    .clear-link {
        color: #b32417;
        font-size: 11.5px;
        font-weight: 700;
        cursor: pointer;
        display: inline-block;
        margin-top: 5px;
        margin-bottom: 15px;
        background: none;
        border: none;
        padding: 0;
        text-decoration: none;
        transition: opacity 0.2s;
    }
    .clear-link:hover {
        opacity: 0.8;
        text-decoration: underline;
    }

    /* Right Job Panel Glassmorphism Architecture */
    .jobs-panel {
        flex: 1;
        background: rgba(255, 255, 255, 0.55);
        backdrop-filter: blur(25px);
        -webkit-backdrop-filter: blur(25px);
        border: 1px solid rgba(255, 255, 255, 0.8);
        border-radius: 16px;
        padding: 26px;
        box-shadow: 0 16px 36px rgba(16, 54, 16, 0.06);
    }

    /* Glass Table Design */
    .jobs-table {
        width: 100%;
        border-collapse: separate;
        border-spacing: 0 8px; /* Gives row card separation effect */
        margin-top: 15px;
    }

    .jobs-table th {
        background: rgba(16, 73, 16, 0.08);
        padding: 14px 12px;
        text-align: left;
        font-size: 13.5px;
        font-weight: 800;
        color: #0d380d;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }
    
    .jobs-table th:first-child { border-radius: 8px 0 0 8px; }
    .jobs-table th:last-child { border-radius: 0 8px 8px 0; }

    .jobs-table td {
        background: rgba(255, 255, 255, 0.4);
        border-top: 1px solid rgba(255, 255, 255, 0.7);
        border-bottom: 1px solid rgba(255, 255, 255, 0.5);
        padding: 16px 12px;
        font-size: 14px;
        color: #222;
        font-weight: 500;
        vertical-align: middle;
        transition: all 0.2s ease;
    }
    
    .jobs-table td:first-child { 
        border-left: 1px solid rgba(255, 255, 255, 0.7);
        border-radius: 8px 0 0 8px; 
    }
    .jobs-table td:last-child { 
        border-right: 1px solid rgba(255, 255, 255, 0.5);
        border-radius: 0 8px 8px 0; 
    }

    /* Frosted lift interaction on hovering rows */
    .jobs-table tr:hover td { 
        background: rgba(255, 255, 255, 0.85); 
        transform: translateY(-1px);
        box-shadow: 0 4px 12px rgba(16, 73, 16, 0.04);
        color: #000;
    }

    .job-title-link {
        color: #114711;
        font-weight: 700;
        text-decoration: none;
        cursor: pointer;
        transition: color 0.2s;
    }
    .job-title-link:hover { 
        color: #1b5e20;
        text-decoration: underline; 
    }

    /* Premium Dynamic Action Buttons */
    .apply-btn {
        background: linear-gradient(135deg, #1b5e20 0%, #0d3c11 100%);
        color: white;
        padding: 8px 18px;
        border-radius: 6px;
        border: none;
        font-size: 13px;
        font-weight: 700;
        cursor: pointer;
        white-space: nowrap;
        box-shadow: 0 4px 10px rgba(27, 94, 32, 0.2);
        transition: all 0.2s ease;
    }
    .apply-btn:hover { 
        transform: translateY(-1px);
        box-shadow: 0 6px 14px rgba(27, 94, 32, 0.3);
    }

    .search-btn {
        background: linear-gradient(135deg, #1b5e20 0%, #0d3c11 100%);
        color: white;
        padding: 10px 20px;
        border: none;
        border-radius: 8px;
        cursor: pointer;
        font-size: 14px;
        font-weight: 700;
        width: 100%;
        margin-top: 5px;
        box-shadow: 0 4px 10px rgba(27, 94, 32, 0.2);
        transition: all 0.2s ease;
    }
    .search-btn:hover {
        box-shadow: 0 6px 14px rgba(27, 94, 32, 0.3);
    }

    .clear-all-btn {
        background: rgba(255, 255, 255, 0.6);
        border: 1px solid rgba(16, 73, 16, 0.3);
        color: #114711;
        padding: 7px 15px;
        border-radius: 6px;
        margin-top: 10px;
        font-size: 13px;
        font-weight: 700;
        cursor: pointer;
        width: 100%;
        transition: all 0.2s ease;
    }
    .clear-all-btn:hover {
        background: #ffffff;
        border-color: #1b5e20;
    }

    .page-btn {
        padding: 6px 12px;
        border: 1px solid rgba(16, 73, 16, 0.2);
        border-radius: 6px;
        cursor: pointer;
        background: rgba(255, 255, 255, 0.6);
        color: #114711;
        font-size: 13px;
        font-weight: 600;
        transition: all 0.2s ease;
    }
    .page-btn:hover:not(:disabled) {
        background: #ffffff;
        border-color: #1b5e20;
    }
    .page-btn.active {
        background: #1b5e20;
        color: white;
        border-color: #1b5e20;
    }
    .page-btn:disabled {
        opacity: 0.4;
        cursor: not-allowed;
    }

    /* Industry metric list items styling */
    .industry-item {
        display: flex;
        justify-content: space-between;
        padding: 4px 0;
        border-bottom: 1px dashed rgba(16, 73, 16, 0.1);
    }
    .industry-item:last-child { border-bottom: none; }

    @@media (max-width: 1050px) {
        .jobs-layout { flex-direction: column; }
        .filter-panel { width: 100%; }
    }
</style>

@code {
