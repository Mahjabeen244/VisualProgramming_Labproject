@page "/jobs"
@rendermode InteractiveServer
<PageTitle>Jobs - Punjab Jobs Online</PageTitle>

<style>
    .jobs-wrapper {
        padding: 30px 20px;
        background: #f5f5f5;
        min-height: 100vh;
    }

    .jobs-layout {
        display: flex;
        gap: 20px;
        max-width: 1200px;
        margin: 0 auto;
    }

    .filter-panel {
        width: 280px;
        flex-shrink: 0;
    }

    .filter-box {
        background: #f0f0f0;
        border-radius: 4px;
        padding: 20px;
    }

    .filter-title {
        color: #1a6bbf;
        font-weight: bold;
        font-size: 18px;
        border-bottom: 2px solid #ccc;
        padding-bottom: 10px;
        margin-bottom: 15px;
    }

    .filter-section-title {
        color: #1a6bbf;
        font-weight: bold;
        font-size: 14px;
        margin-top: 20px;
        margin-bottom: 10px;
    }

    .clear-link {
        color: #1a6bbf;
        font-size: 12px;
        cursor: pointer;
        text-decoration: none;
        display: block;
        margin-top: 4px;
    }

    .jobs-panel {
        flex: 1;
        background: white;
        border-radius: 4px;
        padding: 20px;
    }

    .jobs-table {
        width: 100%;
        border-collapse: collapse;
    }

    .jobs-table th {
        background: #e0e0e0;
        padding: 12px 10px;
        text-align: left;
        font-size: 13px;
        font-weight: bold;
    }

    .jobs-table td {
        padding: 12px 10px;
        font-size: 13px;
        border-bottom: 1px solid #eee;
        vertical-align: top;
    }

    .job-title-link {
        color: #1a6bbf;
        font-weight: bold;
        text-decoration: none;
        cursor: pointer;
    }

    .job-title-link:hover {
        text-decoration: underline;
    }

    .apply-btn {
        background: #2d7a2d;
        color: white;
        padding: 5px 14px;
        border-radius: 3px;
        border: none;
        font-size: 13px;
        cursor: pointer;
    }

    .search-btn {
        background: #2d7a2d;
        color: white;
        padding: 8px 20px;
        border: none;
        border-radius: 3px;
        cursor: pointer;
        font-size: 14px;
        width: 100%;
        margin-top: 10px;
    }

    .page-btn {
        padding: 5px 10px;
        border: 1px solid #ddd;
        border-radius: 3px;
        cursor: pointer;
        background: white;
        font-size: 13px;
    }

    .page-btn.active {
        background: #2d7a2d;
        color: white;
        border-color: #2d7a2d;
    }

    .show-entries {
        display: flex;
        align-items: center;
        gap: 8px;
        margin-bottom: 15px;
        font-size: 13px;
    }
</style>

@code {
    private List<JobItem> AllJobs = new();
    private List<JobItem> FilteredJobs = new();
    private string SearchText = "";
    private string SelectedDepartment = "";
    private string SelectedLocation = "";
    private int CurrentPage = 1;
    private int PageSize = 10;
    private int TotalPages => (int)Math.Ceiling((double)FilteredJobs.Count / PageSize);
    private List<JobItem> PagedJobs => FilteredJobs.Skip((CurrentPage - 1) * PageSize).Take(PageSize).ToList();

    protected override void OnInitialized()
    {
        AllJobs = new List<JobItem>
        {
            new JobItem { Id=1, Title="Assistant Director (Research, Data & Evaluation)", Department="Social Welfare & Baitul Mall", Project="The Council on the Rights of Persons with Disabilities", Province="PUNJAB", LastDate="01-Jun-2026" },
            new JobItem { Id=2, Title="Deputy Director (Admin & Finance)", Department="Social Welfare & Baitul Mall", Project="The Council on the Rights of Persons with Disabilities", Province="PUNJAB", LastDate="01-Jun-2026" },
            new JobItem { Id=3, Title="Assistant Director (Administration)", Department="Social Welfare & Baitul Mall", Project="The Council on the Rights of Persons with Disabilities", Province="PUNJAB", LastDate="01-Jun-2026" },
            new JobItem { Id=4, Title="Quality Assurance Programmer", Department="Directorate General Monitoring and Evaluation", Project="Restructuring of DG (M & E) for improved Monitoring & Evaluation", Province="PUNJAB", LastDate="10-Jun-2026" },
            new JobItem { Id=5, Title="Database Administrator", Department="Directorate General Monitoring and Evaluation", Project="Restructuring of DG (M & E) for improved Monitoring & Evaluation", Province="PUNJAB", LastDate="10-Jun-2026" },
            new JobItem { Id=6, Title="Software Programmer", Department="Directorate General Monitoring and Evaluation", Project="Restructuring of DG (M & E) for improved Monitoring & Evaluation", Province="PUNJAB", LastDate="10-Jun-2026" },
            new JobItem { Id=7, Title="Sr. Software Programmer", Department="Directorate General Monitoring and Evaluation", Project="Restructuring of DG (M & E) for improved Monitoring & Evaluation", Province="PUNJAB", LastDate="10-Jun-2026" },
            new JobItem { Id=8, Title="Deputy Director (Communications Specialist)", Department="Punjab Environment Protection Department", Project="SP&IU", Province="PUNJAB", LastDate="28-May-2026" },
            new JobItem { Id=9, Title="Deputy Director (Monitoring & Evaluation Expert)", Department="Punjab Environment Protection Department", Project="SP&IU", Province="PUNJAB", LastDate="28-May-2026" },
            new JobItem { Id=10, Title="Bomb Disposal Technician", Department="Directorate Civil Defence Punjab", Project="Directorate Civil Defence Punjab", Province="PUNJAB", LastDate="02-Jun-2026" },
            new JobItem { Id=11, Title="Assistant Director HR", Department="Punjab Govt.", Project="Punjab Public Service Commission", Province="PUNJAB", LastDate="15-Jun-2026" },
            new JobItem { Id=12, Title="Data Entry Operator", Department="LGCD Govt of Punjab", Project="Local Government Punjab", Province="PUNJAB", LastDate="20-Jun-2026" },
            new JobItem { Id=13, Title="Finance Officer", Department="Finance Department", Project="Punjab Finance Department", Province="PUNJAB", LastDate="25-Jun-2026" },
            new JobItem { Id=14, Title="IT Officer", Department="Information Technology", Project="Punjab IT Board", Province="PUNJAB", LastDate="30-Jun-2026" },
            new JobItem { Id=15, Title="Environmental Inspector", Department="Environmental Protection", Project="Punjab EPA", Province="PUNJAB", LastDate="05-Jul-2026" },
        };
        FilteredJobs = AllJobs.ToList();
    }

    private void ApplyFilter()
    {
        FilteredJobs = AllJobs.Where(j =>
            (string.IsNullOrEmpty(SearchText) || j.Title.Contains(SearchText, StringComparison.OrdinalIgnoreCase) ||
             j.Department.Contains(SearchText, StringComparison.OrdinalIgnoreCase)) &&
            (string.IsNullOrEmpty(SelectedDepartment) || j.Department.Contains(SelectedDepartment, StringComparison.OrdinalIgnoreCase)) &&
            (string.IsNullOrEmpty(SelectedLocation) || j.Province.Contains(SelectedLocation, StringComparison.OrdinalIgnoreCase))
        ).ToList();
        CurrentPage = 1;
    }

    private void ClearSearch()
    {
        SearchText = "";
        ApplyFilter();
    }

    private void ClearDepartment()
    {
        SelectedDepartment = "";
        ApplyFilter();
    }

    private void ClearLocation()
    {
        SelectedLocation = "";
        ApplyFilter();
    }

    private void ClearFilter()
    {
        SearchText = "";
        SelectedDepartment = "";
        SelectedLocation = "";
        FilteredJobs = AllJobs.ToList();
        CurrentPage = 1;
    }

    private void GoToPage(int page)
    {
        if (page >= 1 && page <= TotalPages)
            CurrentPage = page;
    }

    private void OnSearchInput(ChangeEventArgs e)
    {
        SearchText = e.Value?.ToString() ?? "";
        ApplyFilter();
    }

    public class JobItem
    {
        public int Id { get; set; }
        public string Title { get; set; } = "";
        public string Department { get; set; } = "";
        public string Project { get; set; } = "";
        public string Province { get; set; } = "";
        public string LastDate { get; set; } = "";
    }
}

<div class="jobs-wrapper">
    <h2 style="max-width:1200px; margin:0 auto 20px auto; font-weight:bold;">Available Jobs</h2>

    <div class="jobs-layout">

        <!-- Filter Panel -->
        <div class="filter-panel">
            <div class="filter-box">
                <div class="filter-title">Filter Search</div>

                <!-- Looking For -->
                <input type="text" class="form-control"
                       placeholder="Looking for..."
                       value="@SearchText"
                       @oninput="OnSearchInput"
                       style="font-size:13px;" />
                <a class="clear-link" @onclick="ClearSearch">Clear Title</a>

                <!-- Departments -->
                <select class="form-select mt-3" @bind="SelectedDepartment" style="font-size:13px;">
                    <option value="">Departments</option>
                    <option>Social Welfare & Baitul Mall</option>
                    <option>Directorate General Monitoring and Evaluation</option>
                    <option>Punjab Environment Protection Department</option>
                    <option>Directorate Civil Defence Punjab</option>
                    <option>LGCD Govt of Punjab</option>
                    <option>Finance Department</option>
                    <option>Information Technology</option>
                </select>
                <a class="clear-link" @onclick="ClearDepartment">Clear Departments</a>

                <!-- Location -->
                <select class="form-select mt-3" @bind="SelectedLocation" style="font-size:13px;">
                    <option value="">Location</option>
                    <option>PUNJAB</option>
                    <option>Lahore</option>
                    <option>Multan</option>
                    <option>Rawalpindi</option>
                    <option>Faisalabad</option>
                </select>
                <a class="clear-link" @onclick="ClearLocation">Clear Location</a>

                <button class="search-btn" @onclick="ApplyFilter">Search</button>

                <!-- By Industry -->
                <div class="filter-section-title">By Industry</div>
                <div style="font-size:13px; line-height:2;">
                    <div>N.G.O/ Social Services (3)</div>
                    <div>Environmental Protection (2)</div>
                    <div>Information Technology (7)</div>
                    <div>Punjab Govt. (32)</div>
                    <div>Services (19)</div>
                    <div>Energy Department (2)</div>
                    <div>LGCD Govt of Punjab (22)</div>
                    <div>Finance (7)</div>
                </div>

                <!-- Type of Contract -->
                <div class="filter-section-title">Type of Contract</div>
                <div style="font-size:13px; line-height:2;">
                    @foreach (var contract in new[] { "Part Time", "Full Time", "Daily Wages", "Permanent", "Regular", "Contract", "Contingency", "Adhoc Basis", "Paid Internship", "Project Based" })
                    {
                        <div><input type="checkbox" /> @contract</div>
                    }
                </div>
                <button @onclick="ClearFilter" style="background:white; border:1px solid #ccc; padding:5px 15px; border-radius:3px; margin-top:8px; font-size:13px; cursor:pointer;">Clear All</button>

                <!-- Career Level -->
                <div class="filter-section-title">Career Level</div>
                <div style="font-size:13px; line-height:2;">
                    @foreach (var level in new[] { "Student/Internship", "Entry Level", "Mid Career", "Management", "Executive/Director", "Senior Management", "Paid Internship" })
                    {
                        <div><input type="radio" name="career" /> @level</div>
                    }
                </div>
                <button @onclick="ClearFilter" style="background:white; border:1px solid #ccc; padding:5px 15px; border-radius:3px; margin-top:8px; font-size:13px; cursor:pointer;">Clear All</button>
            </div>
        </div>

        <!-- Jobs Panel -->
        <div class="jobs-panel">

            <!-- Show Entries + Search -->
            <div class="show-entries">
                <span>Show</span>
                <select @bind="PageSize" style="width:60px; font-size:13px;" class="form-select form-select-sm">
                    <option value="10">10</option>
                    <option value="25">25</option>
                    <option value="50">50</option>
                </select>
                <span>entries</span>
                <span style="margin-left:auto;">
                    Search:
                    <input type="text"
                           value="@SearchText"
                           @oninput="OnSearchInput"
                           style="border:1px solid #ccc; padding:4px 8px; font-size:13px; margin-left:5px;" />
                </span>
            </div>

            <!-- Table -->
            <table class="jobs-table">
                <thead>
                    <tr>
                        <th>Job Title</th>
                        <th>Department</th>
                        <th>Project</th>
                        <th>Province</th>
                        <th>Last Apply Date</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @if (PagedJobs.Count == 0)
                    {
                        <tr>
                            <td colspan="6" style="text-align:center; padding:20px; color:#666;">
                                No jobs found matching your search.
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var job in PagedJobs)
                        {
                            <tr>
                                <td>
                                    <a class="job-title-link" href="/job-detail/@job.Id">@job.Title</a>
                                </td>
                                <td>@job.Department</td>
                                <td>@job.Project</td>
                                <td>@job.Province</td>
                                <td>@job.LastDate</td>
                                <td>
                                    <button class="apply-btn">Apply</button>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>

            <!-- Pagination -->
            <div style="display:flex; justify-content:space-between; align-items:center; margin-top:15px; font-size:13px;">
                <span>
                    Showing @((CurrentPage - 1) * PageSize + 1)
                    to @(Math.Min(CurrentPage * PageSize, FilteredJobs.Count))
                    of @FilteredJobs.Count entries
                </span>
                <div style="display:flex; gap:5px;">
                    <button class="page-btn"
                            @onclick="() => GoToPage(CurrentPage - 1)"
                            disabled="@(CurrentPage == 1)">Previous</button>
                    @for (int i = 1; i <= TotalPages; i++)
                    {
                        var pageNum = i;
                        <button class="page-btn @(CurrentPage == pageNum ? "active" : "")"
                                @onclick="() => GoToPage(pageNum)">@pageNum</button>
                    }
                    <button class="page-btn"
                            @onclick="() => GoToPage(CurrentPage + 1)"
                            disabled="@(CurrentPage == TotalPages)">Next</button>
                </div>
            </div>

        </div>
    </div>
</div>