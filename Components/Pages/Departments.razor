@page "/departments"
@rendermode InteractiveServer
<PageTitle>Departmental Contacts - Punjab Jobs Online</PageTitle>

<style>
    .dept-wrapper {
        padding: 30px 40px;
        background: white;
        min-height: 100vh;
    }

    .dept-card {
        background: white;
        border: 1px solid #e0e0e0;
        border-radius: 4px;
        padding: 20px;
        height: 100%;
        transition: all 0.25s ease;
    }

    .dept-card:hover {
        transform: translateY(-3px);
        box-shadow: 0 4px 15px rgba(0,0,0,0.1);
    }

    .dept-name {
        color: #1a6bbf;
        font-size: 15px;
        font-weight: bold;
        margin-bottom: 12px;
        line-height: 1.4;
    }

    .dept-info {
        font-size: 13px;
        color: #666;
        margin-bottom: 8px;
        display: flex;
        align-items: flex-start;
        gap: 8px;
    }

    .dept-info a {
        color: #555;
        text-decoration: none;
        word-break: break-all;
    }

    .dept-info a:hover {
        color: #1a6bbf;
        text-decoration: underline;
    }

    .page-btn {
        padding: 5px 12px;
        border: 1px solid #ddd;
        border-radius: 3px;
        cursor: pointer;
        background: white;
        font-size: 13px;
        color: #1a6bbf;
    }

    .page-btn.active {
        background: #1a6bbf;
        color: white;
        border-color: #1a6bbf;
    }

    .page-btn:disabled {
        color: #999;
        cursor: not-allowed;
        background: #f5f5f5;
    }

    .grey-box {
        background: #e8e8e8;
        border-radius: 4px;
        padding: 25px;
    }
</style>

