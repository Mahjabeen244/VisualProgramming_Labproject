@page "/departments"
@using Microsoft.EntityFrameworkCore
@inject IDbContextFactory<ApplicationDbContext> DbFactory
@rendermode InteractiveServer

<div class="container py-4">
    <h2 class="mb-4 text-dark font-weight-bold" style="font-family: Arial, sans-serif;">Departmental Contacts</h2>

    @if (departments == null)
    {
        <div class="d-flex justify-content-center my-5">
            <div class="spinner-border text-success" role="status">
                <span class="visually-hidden">Loading...</span>
            </div>
        </div>
    }
    else if (!departments.Any())
    {
        <div class="alert alert-info">No departmental contacts found in the database.</div>
    }
    else
    {
        <div class="row g-4">
            @foreach (var dept in departments)
            {
                <div class="col-12 col-md-6 col-lg-4">
                    <div class="card h-100 shadow-sm border-0 p-3" style="border-radius: 4px; background-color: #ffffff;">
                        <div class="card-body d-flex flex-column justify-content-between p-2">
                            <div>
                                <h5 class="card-title text-primary font-weight-bold mb-3" style="font-size: 16px; color: #1a6bbf !important;">
                                    @dept.Name
                                </h5>
                                
                                <p class="card-text mb-2 text-muted" style="font-size: 14px;">
                                    <span class="me-2 text-primary">📍</span> @dept.Description
                                </p>
                                
                                <p class="card-text mb-2 text-muted" style="font-size: 14px;">
                                    <span class="me-2 text-primary">📞</span> @dept.ContactPhone
                                </p>
                            </div>
                            
                            <p class="card-text mt-2 mb-0" style="font-size: 14px;">
                                <span class="me-2 text-primary">✉️</span> 
                                <a href="mailto:@dept.ContactEmail" style="color: #4a4a4a; text-decoration: none;">@dept.ContactEmail</a>
                            </p>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

@code {
    private List<Department>? departments;

    protected override async Task OnInitializedAsync()
    {
        using var context = DbFactory.CreateDbContext();
        departments = await context.Departments.ToListAsync();
    }
}