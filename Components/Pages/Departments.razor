    private void GoToPage(int page)
    {
        if (page >= 1 && page <= TotalPages)
            CurrentPage = page;
    }

    public class DeptItem
    {
        public string Name { get; set; } = "";
        public string Location { get; set; } = "";
        public string Phone { get; set; } = "";
        public string Email { get; set; } = "";
    }
}

<div class="dept-wrapper">
    <h2 style="max-width:1250px; margin:0 auto 24px auto; font-weight:800; font-size:28px; color: #0b2e0b;">Departmental Contacts</h2>

    <div class="grey-box">
        <div class="row g-4 mb-4">
            @foreach (var dept in PagedDepts)
            {
                <div class="col-12 col-md-6 col-lg-4">
                    <div class="dept-card">
                        <div class="dept-name">@dept.Name</div>
                        <div class="dept-info">
                            <span>📍</span>
                            <span>@dept.Location</span>
                        </div>
                        <div class="dept-info">
                            <span>📞</span>
                            <a href="tel:@dept.Phone">@dept.Phone</a>
                        </div>
                        <div class="dept-info">
                            <span>✉️</span>
                            <a href="mailto:@dept.Email">@dept.Email</a>
                        </div>
                    </div>
                </div>
            }
        </div>

        @if (TotalPages > 1)
        {
            <div style="display:flex; justify-content: space-between; align-items: center; margin-top:25px; font-size:14px; color: #114711; font-weight: 700;">
                <span>Showing page @CurrentPage of @TotalPages allocations</span>
                
                <div style="display:flex; gap:6px;">
                    <button class="page-btn" @onclick="() => GoToPage(CurrentPage - 1)" disabled="@(CurrentPage == 1)">Previous</button>
                    @for (int i = 1; i <= TotalPages; i++)
                    {
                        var pageNum = i;
                        <button class="page-btn @(CurrentPage == pageNum ? "active" : "")"
                                @onclick="() => GoToPage(pageNum)">@pageNum</button>
                    }
                    <button class="page-btn" @onclick="() => GoToPage(CurrentPage + 1)" disabled="@(CurrentPage == TotalPages)">Next</button>
                </div>
            </div>
        }
    </div>
</div>