@page "/departments"
@rendermode InteractiveServer
<PageTitle>Departmental Contacts - Punjab Jobs Online</PageTitle>

<style>
    /* Premium Radiant Mint Soft Blend Background Matching Main System Layout */
    .dept-wrapper {
        background: linear-gradient(135deg, #85c385 0%, #d8edd8 100%);
        padding: 40px 20px;
        min-height: 100vh;
        font-family: system-ui, -apple-system, sans-serif;
    }

    /* Core Architectural Glass Box Setup */
    .grey-box {
        background: rgba(255, 255, 255, 0.45) !important;
        backdrop-filter: blur(25px);
        -webkit-backdrop-filter: blur(25px);
        border: 1px solid rgba(255, 255, 255, 0.75);
        border-radius: 16px;
        padding: 30px;
        box-shadow: 0 16px 36px rgba(16, 54, 16, 0.05);
        max-width: 1250px;
        margin: 0 auto;
    }

    /* Glassmorphism Inner Contact Card Design Elements */
    .dept-card {
        background: rgba(255, 255, 255, 0.4) !important;
        backdrop-filter: blur(10px);
        -webkit-backdrop-filter: blur(10px);
        border: 1px solid rgba(255, 255, 255, 0.7) !important;
        border-radius: 12px !important;
        padding: 24px;
        height: 100%;
        transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
        box-shadow: 0 4px 15px rgba(0, 0, 0, 0.02);
        border-left: 5px solid rgba(27, 94, 32, 0.6) !important; /* Elegant Forest Green Side Border Accent */
        display: flex;
        flex-direction: column;
    }

    .dept-card:hover {
        transform: translateY(-4px);
        background: rgba(255, 255, 255, 0.85) !important;
        border-color: rgba(255, 255, 255, 0.9) !important;
        border-left: 5px solid #1b5e20 !important; /* Highlighting to rich solid deep green */
        box-shadow: 0 12px 28px rgba(16, 73, 16, 0.08);
    }

    .dept-name {
        color: #0b2e0b;
        font-size: 16px;
        font-weight: 800;
        margin-bottom: 16px;
        line-height: 1.4;
        padding-bottom: 12px;
        border-bottom: 1px dashed rgba(16, 73, 16, 0.15);
    }

    .dept-info {
        font-size: 13.5px;
        color: #222;
        font-weight: 500;
        margin-bottom: 10px;
        display: flex;
        align-items: flex-start;
        gap: 10px;
        line-height: 1.5;
    }

    .dept-info span:first-child {
        font-size: 15px;
        opacity: 0.85;
    }

    .dept-info a {
        color: #114711;
        text-decoration: none;
        word-break: break-all;
        font-weight: 600;
        transition: color 0.2s;
    }

    .dept-info a:hover {
        color: #1b5e20;
        text-decoration: underline;
    }

    /* Match system pagination glass styles */
    .page-btn {
        padding: 6px 14px;
        border: 1px solid rgba(16, 73, 16, 0.2);
        border-radius: 6px;
        cursor: pointer;
        background: rgba(255, 255, 255, 0.6);
        color: #114711;
        font-size: 13px;
        font-weight: 700;
        transition: all 0.2s ease;
    }
    
    .page-btn:hover:not(:disabled) {
        background: #ffffff;
        border-color: #1b5e20;
    }
    
    .page-btn.active {
        background: #1b5e20;
        color: white;
        border-color: #1b5e20;
    }
    
    .page-btn:disabled {
        opacity: 0.4;
        cursor: not-allowed;
    }
</style>

