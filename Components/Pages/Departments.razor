    private int CurrentPage = 1;
    private const int PageSize = 9;
    private int TotalPages => (int)Math.Ceiling((double)AllDepts.Count / PageSize);
    private List<DeptItem> PagedDepts => AllDepts.Skip((CurrentPage - 1) * PageSize).Take(PageSize).ToList();

    protected override void OnInitialized()
    {
        AllDepts = new List<DeptItem>
        {
            new DeptItem { Name="Agency For Barani Area Development", Location="Rawalpindi", Phone="00519292019", Email="abad.development@gmail.com" },
            new DeptItem { Name="Agriculture Department", Location="Lahore", Phone="04299210499", Email="agri@punjab.gov.pk" },
            new DeptItem { Name="Allied Hospital, Faisalabad", Location="Faisalabad", Phone="00419210186", Email="ms.ah.fsd@punjab.gov.pk" },
            new DeptItem { Name="Aviation Flight (RW), S&GAD", Location="Lahore", Phone="04299220312", Email="soaviationsgad@gmail.com" },
            new DeptItem { Name="Ayub Agricultural Research Institute, Faisalabad", Location="Faisalabad", Phone="04211111111", Email="director.general@aari.punjab.gov.pk" },
            new DeptItem { Name="Aziz Bhatti Shaheed Teaching Hospital, Gujrat", Location="Gujrat", Phone="04211111111", Email="absh.gujrat@yahoo.com" },
            new DeptItem { Name="Aziz Bhatti Shaheed Teaching Hospital, Gujrat", Location="Gujrat", Phone="00539260101", Email="absh.gujrat@yahoo.com" },
            new DeptItem { Name="Bahawalpur Waste Management Company", Location="Bahawalpur", Phone="00429255202", Email="jobsonlinesupport@punjab.gov.pk" },
            new DeptItem { Name="Bhakkar Job Bureau", Location="Bhakkar", Phone="00453920006", Email="bhakkarjobbureau@gmail.com" },
            new DeptItem { Name="Board of Intermediate & Secondary Education, Lahore", Location="Lahore", Phone="04299200161", Email="bise.lahore@punjab.gov.pk" },
            new DeptItem { Name="Child Protection & Welfare Bureau", Location="Lahore", Phone="04299211234", Email="cpwb@punjab.gov.pk" },
            new DeptItem { Name="Civil Hospital Bahawalpur", Location="Bahawalpur", Phone="00629200001", Email="chb@punjab.gov.pk" },
            new DeptItem { Name="DCO Office Multan", Location="Multan", Phone="06199200001", Email="dco.multan@punjab.gov.pk" },
            new DeptItem { Name="Directorate Civil Defence Punjab", Location="Lahore", Phone="04299220000", Email="civildefence@punjab.gov.pk" },
            new DeptItem { Name="Directorate General Monitoring and Evaluation", Location="Lahore", Phone="04299211111", Email="dgme@punjab.gov.pk" },
            new DeptItem { Name="Environmental Protection Department", Location="Lahore", Phone="04299230000", Email="epd@punjab.gov.pk" },
            new DeptItem { Name="Finance Department Punjab", Location="Lahore", Phone="04299212000", Email="finance@punjab.gov.pk" },
            new DeptItem { Name="Health Department Punjab", Location="Lahore", Phone="04299213000", Email="health@punjab.gov.pk" },
            new DeptItem { Name="Information Technology Board", Location="Lahore", Phone="04299214000", Email="info@pitb.gov.pk" },
            new DeptItem { Name="LGCD Govt of Punjab", Location="Lahore", Phone="04299215000", Email="lgcd@punjab.gov.pk" },
