            new DeptItem { Name="Punjab Environment Protection Agency", Location="Lahore", Phone="04299217000", Email="pepa@punjab.gov.pk" },
            new DeptItem { Name="Punjab Public Service Commission", Location="Lahore", Phone="04299218000", Email="ppsc@punjab.gov.pk" },
            new DeptItem { Name="Punjab Rural Municipal Services Company", Location="Lahore", Phone="04299219000", Email="prmsc@punjab.gov.pk" },
            new DeptItem { Name="Social Welfare & Baitul Mall Punjab", Location="Lahore", Phone="04299220001", Email="swbm@punjab.gov.pk" },
            new DeptItem { Name="Special Education Department", Location="Lahore", Phone="04299221000", Email="sed@punjab.gov.pk" },
            new DeptItem { Name="Sports Board Punjab", Location="Lahore", Phone="04299222000", Email="sbp@punjab.gov.pk" },
        };
    }

    private void GoToPage(int page)
    {
        if (page >= 1 && page <= TotalPages)
            CurrentPage = page;
    }

    public class DeptItem
    {
        public string Name { get; set; } = "";
        public string Location { get; set; } = "";
        public string Phone { get; set; } = "";
        public string Email { get; set; } = "";
    }
}

<div class="dept-wrapper">
    <h2 style="font-weight:bold; font-size:26px; margin-bottom:20px;">Departmental Contacts</h2>

    <div class="grey-box">
        <div class="row g-4 mb-4">
            @foreach (var dept in PagedDepts)
            {
                <div class="col-12 col-md-6 col-lg-4">
                    <div class="dept-card">
                        <div class="dept-name">@dept.Name</div>
                        <div class="dept-info">
                            <span>📍</span>
                            <span>@dept.Location</span>
                        </div>
                        <div class="dept-info">
                            <span>📞</span>
                            <a href="tel:@dept.Phone">@dept.Phone</a>
                        </div>
                        <div class="dept-info">
                            <span>✉️</span>
                            <a href="mailto:@dept.Email">@dept.Email</a>
                        </div>
                    </div>
                </div>
            }
        </div>

        <!-- Pagination -->
        @if (TotalPages > 1)
        {
            <div style="display:flex; gap:5px; margin-top:10px;">
                <button class="page-btn" @onclick="() => GoToPage(CurrentPage - 1)" disabled="@(CurrentPage == 1)">Previous</button>
                @for (int i = 1; i <= TotalPages; i++)
                {
                    var pageNum = i;
                    <button class="page-btn @(CurrentPage == pageNum ? "active" : "")"
                            @onclick="() => GoToPage(pageNum)">@pageNum</button>
                }
                <button class="page-btn" @onclick="() => GoToPage(CurrentPage + 1)" disabled="@(CurrentPage == TotalPages)">Next</button>
                <button class="page-btn" @onclick="() => GoToPage(TotalPages)" disabled="@(CurrentPage == TotalPages)">Last ›</button>
            </div>
        }
    </div>
</div>