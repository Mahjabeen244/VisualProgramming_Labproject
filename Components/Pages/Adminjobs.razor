@page "/admin/jobs"
@rendermode InteractiveServer
@inject Group4_VISUALPROGRAMMING_PROJECT.Data.JobService JobService
@inject NavigationManager NavManager
@using Group4_VISUALPROGRAMMING_PROJECT.Data
@using Project.Models

<div class="container mt-5 pt-4">
    <div class="glass-main-card p-4 text-white" style="background: rgba(20, 50, 20, 0.6); backdrop-filter: blur(15px); border-radius: 15px;">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h2>Govt Admin Portal: Manage Job Openings</h2>
            <button class="btn btn-success" @onclick="OpenAddModal">＋ Post New Position</button>
        </div>

        <table class="table text-white table-striped table-hover">
            <thead>
                <tr>
                    <th>Position Title</th>
                    <th>Location</th>
                    <th>Contract</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (AdminJobList == null)
                {
                    <tr><td colspan="4" class="text-center">Loading Admin Database Context...</td></tr>
                }
                else if (!AdminJobList.Any())
                {
                    <tr><td colspan="4" class="text-center">No jobs found in the administrative registry.</td></tr>
                }
                else
                {
                    @foreach (var job in AdminJobList)
                    {
                        <tr>
                            <td>@job.Title</td>
                            <td>@job.Location</td> 
                            <td><span class="badge bg-warning text-dark">@job.Description</span></td>
                            <td>
                                <button class="btn btn-sm btn-danger" @onclick="() => DeletePosition(job.Id)">Delete</button>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

@code {
    private List<Job> AdminJobList;

    protected override async Task OnInitializedAsync()
    {
        await LoadPositions();
    }

    private async Task LoadPositions()
    {
        // Tier Separation: Calling the Business Logic Layer instead of direct DB Queries
        AdminJobList = await JobService.GetAllJobsAsync();
    }

    private void OpenAddModal()
    {
        NavManager.NavigateTo("/jobs");
    }

    private async Task DeletePosition(int jobId)
    {
        // Tier Separation: Handing off database mutation logic safely to the service tier
        bool dynamicSuccess = await JobService.DeleteJobAsync(jobId);
        
        if (dynamicSuccess)
        {
            await LoadPositions(); // Instantly refreshes view grid state metrics
        }
    }
}