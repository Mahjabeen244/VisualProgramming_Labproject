@page "/faq"
@rendermode InteractiveServer
<PageTitle>FAQ's - Punjab Jobs Online</PageTitle>

<style>
    .faq-wrapper {
        padding: 40px;
        background: linear-gradient(135deg, #90bb98 0%, #89ee85 100%);
        min-height: 100vh;
    }

    .faq-header {
        text-align: center;
        margin-bottom: 40px;
    }

    .faq-header h2 {
        font-size: 32px;
        font-weight: bold;
        color: #1a5c1a;
        margin-bottom: 10px;
    }

    .faq-header p {
        color: #666;
        font-size: 15px;
    }

    .faq-header-line {
        width: 60px;
        height: 4px;
        background: #2d7a2d;
        margin: 10px auto 0 auto;
        border-radius: 2px;
    }

    .faq-container {
        max-width: 850px;
        margin: 0 auto;
    }

    .faq-item {
        margin-bottom: 12px;
        border-radius: 8px;
        overflow: hidden;
        box-shadow: 0 2px 8px rgba(0,0,0,0.07);
        transition: all 0.3s ease;
    }

    .faq-item:hover {
        box-shadow: 0 4px 15px rgba(0,0,0,0.12);
    }

    .faq-question {
        width: 100%;
        background: white;
        border: none;
        padding: 18px 25px;
        text-align: left;
        font-size: 15px;
        font-weight: 600;
        color: #333;
        cursor: pointer;
        display: flex;
        justify-content: space-between;
        align-items: center;
        transition: all 0.3s ease;
    }

    .faq-question.active {
        background: #2d7a2d;
        color: white;
    }

    .faq-question:hover:not(.active) {
        background: #f0f8f0;
        color: #2d7a2d;
    }

    .faq-number {
        background: #2d7a2d;
        color: white;
        width: 28px;
        height: 28px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 12px;
        font-weight: bold;
        margin-right: 15px;
        flex-shrink: 0;
    }

    .faq-question.active .faq-number {
        background: white;
        color: #2d7a2d;
    }

    .faq-question-text {
        flex: 1;
    }

    .faq-icon {
        width: 28px;
        height: 28px;
        border-radius: 50%;
        background: #e8f5e8;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 14px;
        transition: transform 0.3s ease;
        flex-shrink: 0;
        color: #2d7a2d;
    }

    .faq-question.active .faq-icon {
        background: rgba(255,255,255,0.2);
        color: white;
        transform: rotate(180deg);
    }

    .faq-answer {
        background: white;
        padding: 20px 25px 20px 68px;
        border-top: 2px solid #e8f5e8;
        animation: slideDown 0.3s ease;
    }

    @@keyframes slideDown {
        from { opacity: 0; transform: translateY(-10px); }
        to { opacity: 1; transform: translateY(0); }
    }

    .faq-answer ul {
        margin: 0;
        padding-left: 5px;
        list-style: none;
    }

    .faq-answer ul li {
        padding: 6px 0;
        font-size: 14px;
        color: #555;
        line-height: 1.6;
        display: flex;
        align-items: flex-start;
        gap: 8px;
        border-bottom: 1px solid #f5f5f5;
    }

    .faq-answer ul li:last-child {
        border-bottom: none;
    }

    .faq-answer ul li::before {
        content: '→';
        color: #2d7a2d;
        font-weight: bold;
        flex-shrink: 0;
        margin-top: 1px;
    }
</style>

@code {
    private int? OpenIndex = 0;

    private void Toggle(int index)
    {
        OpenIndex = OpenIndex == index ? null : index;
    }

    private class FaqItem
    {
        public string Question { get; set; } = "";
        public List<string> Answers { get; set; } = new();
    }

    private List<FaqItem> Faqs = new()
    {
        new FaqItem { Question="How can I Register on Job portal?", Answers=new(){"Click on register button available at top right of Job Portal.","Enter valid e-mail address.","Set password and click on register.","An account activation link will be sent to your e-mail ID.","Click on received link for login and accessing your account."} },
        new FaqItem { Question="How can I update my profile?", Answers=new(){"Login to your account.","Click on your profile name at top right.","Select Edit Profile option.","Update the required information and click Save."} },
        new FaqItem { Question="How can I add information on my profile?", Answers=new(){"Login to your account.","Go to My Profile section.","Click on Add Information button.","Fill in details such as education, experience, skills.","Click Save to update your profile."} },
        new FaqItem { Question="How can I view my profile?", Answers=new(){"Login to your account.","Click on your name at the top right corner.","Select View Profile from the dropdown menu."} },
        new FaqItem { Question="How can I edit my profile?", Answers=new(){"Login to your account.","Go to My Profile.","Click the Edit button next to the section you want to update.","Make your changes and click Save."} },
        new FaqItem { Question="How can I search target job?", Answers=new(){"Use the search bar on the home page.","Enter job title, department, or keywords.","Select location and department filters.","Click the Search button to view results."} },
        new FaqItem { Question="How to view all jobs on Job Portal?", Answers=new(){"Click on JOBS in the navigation menu.","All available jobs will be listed.","Use filters on the left to narrow down results.","Click on any job title to view full details."} },
        new FaqItem { Question="What are saved jobs?", Answers=new(){"Saved jobs are jobs you have bookmarked for later.","You can save a job by clicking the bookmark icon on any job listing.","Access your saved jobs from your profile dashboard.","You can apply to saved jobs anytime before the closing date."} },
        new FaqItem { Question="How do I apply for Jobs?", Answers=new(){"Login to your account.","Search for the job you want to apply for.","Click on the job title to view details.","Click the Apply for this Job button.","Confirm your application details and submit."} },
        new FaqItem { Question="How do I know if my job application was submitted successfully?", Answers=new(){"After submitting, you will see a confirmation message on screen.","A confirmation email will be sent to your registered email address.","You can also check your application status in My Applications section."} },
        new FaqItem { Question="How much time will it take to schedule interview after applying?", Answers=new(){"Interview scheduling depends on the hiring department.","You will be notified via email when shortlisted.","Typically it takes 2 to 4 weeks after the application deadline.","Keep checking your email and portal notifications regularly."} },
        new FaqItem { Question="Can I apply for multiple jobs at the same time?", Answers=new(){"Yes, you can apply for multiple jobs simultaneously.","Each application is tracked separately in your profile.","Make sure your profile is complete before applying to multiple positions."} },
        new FaqItem { Question="What documents do I need to apply?", Answers=new(){"Updated CV or Resume.","Educational certificates and transcripts.","CNIC copy.","Experience letters if applicable.","Any other documents mentioned in the job description."} },
        new FaqItem { Question="How can I reset my password?", Answers=new(){"Click on Login at the top of the page.","Click Forgot Password link.","Enter your registered email address.","Check your email for a password reset link.","Click the link and set a new password."} },
        new FaqItem { Question="Who can I contact for support?", Answers=new(){"For technical issues, email: support@punjabgov.pk","For job related queries, contact the respective department.","You can also use the Contact Us form on the portal.","Support is available Monday to Friday, 9am to 5pm."} },
    };
}

<div class="faq-wrapper">

    <div class="faq-header">
        <h2>Frequently Asked Questions</h2>
        <p>Everything you need to know about Punjab Jobs Online</p>
        <div class="faq-header-line"></div>
    </div>

    <div class="faq-container">
        @for (int i = 0; i < Faqs.Count; i++)
        {
            var index = i;
            var faq = Faqs[i];
            var isOpen = OpenIndex == index;

            <div class="faq-item">
                <button class="faq-question @(isOpen ? "active" : "")"
                        @onclick="() => Toggle(index)">
                    <div class="faq-number">@(index + 1)</div>
                    <span class="faq-question-text">@faq.Question</span>
                    <div class="faq-icon">▼</div>
                </button>

                @if (isOpen)
                {
                    <div class="faq-answer">
                        <ul>
                            @foreach (var answer in faq.Answers)
                            {
                                <li>@answer</li>
                            }
                        </ul>
                    </div>
                }
            </div>
        }
    </div>
</div>