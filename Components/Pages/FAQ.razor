@page "/faq"
@rendermode InteractiveServer
<PageTitle>FAQ's - Punjab Jobs Online</PageTitle>

<style>
    .faq-wrapper {
        padding: 30px 40px;
        background: #f5f5f5;
        min-height: 100vh;
    }

    .faq-item {
        background: white;
        border: 1px solid #e0e0e0;
        margin-bottom: 2px;
    }

    .faq-question {
        width: 100%;
        background: #f0f0f0;
        border: none;
        padding: 15px 20px;
        text-align: left;
        font-size: 14px;
        font-weight: normal;
        color: #333;
        cursor: pointer;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .faq-question:hover {
        background: #e8e8e8;
    }

    .faq-question.active {
        background: #f0f0f0;
        color: #333;
    }

    .faq-answer {
        padding: 15px 20px 20px 20px;
        font-size: 14px;
        color: #444;
        line-height: 1.7;
        border-top: 1px solid #eee;
        background: white;
    }

    .faq-answer ul {
        margin: 8px 0;
        padding-left: 20px;
    }

    .faq-answer ul li {
        margin-bottom: 5px;
    }

    .arrow {
        font-size: 12px;
        color: #666;
        transition: transform 0.2s;
    }

    .arrow.open {
        transform: rotate(180deg);
    }
</style>

@code {
    private int? OpenIndex = 0;

    private void Toggle(int index)
    {
        if (OpenIndex == index)
            OpenIndex = null;
        else
            OpenIndex = index;
    }

    private class FaqItem
    {
        public string Question { get; set; } = "";
        public List<string> Answers { get; set; } = new();
    }

    private List<FaqItem> Faqs = new()
    {
        new FaqItem
        {
            Question = "1) How can I Register on Job portal?",
            Answers = new List<string>
            {
                "Click on register button available at top right of Job Portal.",
                "Enter valid e-mail address.",
                "Set password.",
                "Click on register.",
                "An account activation link will be sent to your e-mail ID.",
                "Click on received link for login and accessing your account at Job Portal."
            }
        },
        new FaqItem
        {
            Question = "2) How can I update my profile?",
            Answers = new List<string>
            {
                "Login to your account.",
                "Click on your profile name at top right.",
                "Select Edit Profile option.",
                "Update the required information.",
                "Click Save to apply changes."
            }
        },
        new FaqItem
        {
            Question = "3) How can I add information on my profile?",
            Answers = new List<string>
            {
                "Login to your account.",
                "Go to My Profile section.",
                "Click on Add Information button.",
                "Fill in the required details such as education, experience, skills.",
                "Click Save to update your profile."
            }
        },
        new FaqItem
        {
            Question = "4) How can I view my profile?",
            Answers = new List<string>
            {
                "Login to your account.",
                "Click on your name at the top right corner.",
                "Select View Profile from the dropdown menu."
            }
        },
        new FaqItem
        {
            Question = "5) How can I edit my profile?",
            Answers = new List<string>
            {
                "Login to your account.",
                "Go to My Profile.",
                "Click the Edit button next to the section you want to update.",
                "Make your changes and click Save."
            }
        },
        new FaqItem
        {
            Question = "6) How can I search target job?",
            Answers = new List<string>
            {
                "Use the search bar on the home page.",
                "Enter job title, department, or keywords.",
                "Select location and department filters.",
                "Click the Search button to view results."
            }
        },
        new FaqItem
        {
            Question = "7) How to view all jobs on Job Portal?",
            Answers = new List<string>
            {
                "Click on JOBS in the navigation menu.",
                "All available jobs will be listed.",
                "Use filters on the left to narrow down results.",
                "Click on any job title to view full details."
            }
        },
        new FaqItem
        {
            Question = "8) What are saved jobs?",
            Answers = new List<string>
            {
                "Saved jobs are jobs you have bookmarked for later.",
                "You can save a job by clicking the bookmark icon on any job listing.",
                "Access your saved jobs from your profile dashboard.",
                "You can apply to saved jobs anytime before the closing date."
            }
        },
        new FaqItem
        {
            Question = "9) How do I apply for Jobs?",
            Answers = new List<string>
            {
                "Login to your account.",
                "Search for the job you want to apply for.",
                "Click on the job title to view details.",
                "Click the Apply for this Job button.",
                "Confirm your application details and submit."
            }
        },
        new FaqItem
        {
            Question = "10) How do I know if my job application was submitted successfully?",
            Answers = new List<string>
            {
                "After submitting, you will see a confirmation message on screen.",
                "A confirmation email will be sent to your registered email address.",
                "You can also check your application status in My Applications section."
            }
        },
        new FaqItem
        {
            Question = "11) How much time it will take to schedule interview after applying for a job?",
            Answers = new List<string>
            {
                "Interview scheduling depends on the hiring department.",
                "You will be notified via email when shortlisted.",
                "Typically it takes 2 to 4 weeks after the application deadline.",
                "Keep checking your email and portal notifications regularly."
            }
        },
        new FaqItem
        {
            Question = "12) Can I apply for multiple jobs at the same time?",
            Answers = new List<string>
            {
                "Yes, you can apply for multiple jobs simultaneously.",
                "Each application is tracked separately in your profile.",
                "Make sure your profile is complete before applying to multiple positions."
            }
        },
        new FaqItem
        {
            Question = "13) What documents do I need to apply?",
            Answers = new List<string>
            {
                "Updated CV or Resume.",
                "Educational certificates and transcripts.",
                "CNIC copy.",
                "Experience letters if applicable.",
                "Any other documents mentioned in the job description."
            }
        },
        new FaqItem
        {
            Question = "14) How can I reset my password?",
            Answers = new List<string>
            {
                "Click on Login at the top of the page.",
                "Click Forgot Password link.",
                "Enter your registered email address.",
                "Check your email for a password reset link.",
                "Click the link and set a new password."
            }
        },
        new FaqItem
        {
            Question = "15) Who can I contact for support?",
            Answers = new List<string>
            {
                "For technical issues, email: support@punjabgov.pk",
                "For job related queries, contact the respective department.",
                "You can also use the Contact Us form on the portal.",
                "Support is available Monday to Friday, 9am to 5pm."
            }
        },
         new FaqItem
        {
            Question = "15)I am applying for a job and I receive the message on screen saying your profile doesnot match with this job requirement?",
            Answers = new List<string>
            {
                "In this case you are either not eligible for a job or your profile is incomplete, not downloaded ",
            }
        },
    };
}

<div class="faq-wrapper">
    <h2 style="font-weight:bold; font-size:26px; margin-bottom:20px;">FAQ's</h2>

    <div>
        @for (int i = 0; i < Faqs.Count; i++)
        {
            var index = i;
            var faq = Faqs[i];
            var isOpen = OpenIndex == index;

            <div class="faq-item">
                <button class="faq-question @(isOpen ? "active" : "")"
                        @onclick="() => Toggle(index)">
                    <span>@faq.Question</span>
                    <span class="arrow @(isOpen ? "open" : "")">▼</span>
                </button>

                @if (isOpen)
                {
                    <div class="faq-answer">
                        <ul>
                            @foreach (var answer in faq.Answers)
                            {
                                <li>@answer</li>
                            }
                        </ul>
                    </div>
                }
            </div>
        }
    </div>
</div>