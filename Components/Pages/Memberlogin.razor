@page "/member-login"
@rendermode InteractiveServer
<PageTitle>Member Login - Punjab Jobs Online</PageTitle>

<style>
    .member-wrapper {
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        position: relative;
        overflow: hidden;
    }

    .bg-overlay {
        position: absolute;
        top: 0; left: 0;
        width: 100%; height: 100%;
        background: linear-gradient(135deg,
            #1a3a1a 0%,
            #2d5a2d 30%,
            #1a2a1a 60%,
            #0d1a0d 100%);
        z-index: 0;
    }

    .bg-image {
        position: absolute;
        top: 0; left: 0;
        width: 100%; height: 100%;
        background: url('https://upload.wikimedia.org/wikipedia/commons/thumb/1/1e/Governor_House_Lahore.jpg/1280px-Governor_House_Lahore.jpg') center/cover;
        opacity: 0.4;
        z-index: 0;
    }

    .member-card {
        position: relative;
        z-index: 1;
        background: rgba(0,0,0,0.65);
        border-radius: 8px;
        width: 100%;
        max-width: 420px;
        padding: 40px 35px;
        color: white;
        backdrop-filter: blur(5px);
    }

    .member-card h3 {
        text-align: center;
        font-size: 22px;
        font-weight: bold;
        letter-spacing: 2px;
        margin-bottom: 5px;
    }

    .member-card p {
        text-align: center;
        font-size: 13px;
        color: #ccc;
        margin-bottom: 20px;
    }

    .punjab-logo {
        text-align: center;
        font-size: 50px;
        margin-bottom: 10px;
    }

    .home-label {
        text-align: center;
        font-weight: bold;
        font-size: 14px;
        letter-spacing: 2px;
        border-top: 1px solid #555;
        border-bottom: 1px solid #555;
        padding: 8px 0;
        margin-bottom: 20px;
    }

    .member-input {
        width: 100%;
        padding: 12px 15px;
        background: rgba(255,255,255,0.9);
        border: none;
        border-radius: 4px;
        font-size: 14px;
        margin-bottom: 15px;
        color: #333;
        outline: none;
    }

    .captcha-row {
        display: flex;
        gap: 10px;
        margin-bottom: 15px;
        align-items: center;
    }

    .captcha-display {
        flex: 1;
        background: #2d7a2d;
        color: white;
        padding: 12px 15px;
        border-radius: 4px;
        font-size: 22px;
        font-weight: bold;
        letter-spacing: 8px;
        text-align: center;
        font-family: monospace;
        user-select: none;
    }

    .refresh-btn {
        background: #2d7a2d;
        color: white;
        border: none;
        border-radius: 4px;
        width: 44px;
        height: 44px;
        cursor: pointer;
        font-size: 18px;
    }

    .remember-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 20px;
        font-size: 13px;
    }

    .remember-row a {
        color: #7eb8f7;
        text-decoration: none;
    }

    .login-btn {
        width: 100%;
        background: #4a90d9;
        color: white;
        border: none;
        padding: 12px;
        border-radius: 4px;
        font-size: 15px;
        font-weight: bold;
        cursor: pointer;
        letter-spacing: 1px;
    }

    .login-btn:hover { background: #357abd; }

    .success-msg {
        background: rgba(45,122,45,0.8);
        color: white;
        padding: 12px 15px;
        border-radius: 4px;
        margin-bottom: 15px;
        font-size: 14px;
        text-align: center;
    }

    .error-msg {
        background: rgba(180,30,30,0.8);
        color: white;
        padding: 12px 15px;
        border-radius: 4px;
        margin-bottom: 15px;
        font-size: 14px;
        text-align: center;
    }
</style>

@code {
    private string Email = "";
    private string Password = "";
    private string CaptchaInput = "";
    private string CaptchaCode = "";
    private string Message = "";
    private bool IsSuccess = false;
    private bool RememberMe = false;
    private bool IsLoading = false;

    protected override void OnInitialized()
    {
        GenerateCaptcha();
    }

    private void GenerateCaptcha()
    {
        var chars = "ABCDEFGHJKLMNPQRSTUVWXYZ23456789";
        var random = new Random();
        CaptchaCode = new string(Enumerable.Range(0, 6)
            .Select(_ => chars[random.Next(chars.Length)]).ToArray());
    }

    private async Task HandleLogin()
    {
        Message = "";

        if (string.IsNullOrEmpty(Email))
        { Message = "Please enter email address."; return; }

        if (string.IsNullOrEmpty(Password))
        { Message = "Please enter password."; return; }

        if (CaptchaInput.ToUpper() != CaptchaCode)
        { Message = "Invalid captcha. Please try again."; GenerateCaptcha(); CaptchaInput = ""; return; }

        IsLoading = true;
        await Task.Delay(1000);
        IsLoading = false;
        IsSuccess = true;
        Message = "Login successful! Welcome to Punjab Jobs Portal.";
    }
}

<div class="member-wrapper">
    <div class="bg-image"></div>
    <div class="bg-overlay"></div>

    <div class="member-card">
        <div class="punjab-logo">🏛️</div>
        <h3>SIGN IN</h3>
        <p>Sign In to enter Punjab Job Portal</p>
        <div class="home-label">HOME</div>

        @if (!string.IsNullOrEmpty(Message))
        {
            <div class="@(IsSuccess ? "success-msg" : "error-msg")">@Message</div>
        }

        @if (!IsSuccess)
        {
            <input type="email" class="member-input"
                   placeholder="Email" @bind="Email" />

            <input type="password" class="member-input"
                   placeholder="Password" @bind="Password" />

            <div class="captcha-row">
                <div class="captcha-display">@CaptchaCode</div>
                <button class="refresh-btn" @onclick="GenerateCaptcha">🔄</button>
            </div>

            <input type="text" class="member-input"
                   placeholder="Enter Captcha" @bind="CaptchaInput" />

            <div class="remember-row">
                <label>
                    <input type="checkbox" @bind="RememberMe" style="margin-right:6px;" />
                    Remember me
                </label>
                <a href="/register">Forgot Password?</a>
            </div>

            <button class="login-btn" @onclick="HandleLogin" disabled="@IsLoading">
                @(IsLoading ? "Signing in..." : "Login")
            </button>
        }
        else
        {
            <div style="text-align:center; padding:20px;">
                <div style="font-size:40px;">✅</div>
                <h5 style="color:#2d7a2d; margin-top:10px;">Login Successful!</h5>
                <a href="/">
                    <button style="background:#4a90d9; color:white; border:none; padding:10px 25px; border-radius:4px; cursor:pointer; margin-top:10px; width:100%;">
                        Go to Home
                    </button>
                </a>
            </div>
        }
    </div>
</div>