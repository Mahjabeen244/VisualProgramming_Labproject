        "Management Trainee Officer (Environment)",
        "Senior Risk Analyst",
        "Mechanical Engineer (PPS-08)",
        "Electrical Engineer (PPS-08)",
        "Manager Marketing & Strategy",
        "Manager Civil Works",
        "Manager Operations",
        "IT Manager",
        "Tourism Development Specialist",
        "Chief Conservationist (Built Heritage)",
    };

private void GoToJobs()
{
    if (!string.IsNullOrEmpty(SelectedDept) || !string.IsNullOrEmpty(SelectedLoc))
        Navigation.NavigateTo("/jobs");
}
    private void OnSearchInput(ChangeEventArgs e)
    {
        SearchText = e.Value?.ToString() ?? "";
        if (string.IsNullOrEmpty(SearchText))
        {
            Suggestions = new();
            ShowDropdown = false;
            return;
        }
        Suggestions = AllJobsList
            .Where(j => j.Contains(SearchText, StringComparison.OrdinalIgnoreCase))
            .Take(15)
            .ToList();
        ShowDropdown = Suggestions.Count > 0;
    }

    private void ShowSuggestions()
    {
        if (Suggestions.Count > 0)
            ShowDropdown = true;
    }

    private async Task HideSuggestions()
    {
        await Task.Delay(200);
        ShowDropdown = false;
    }

    private void SelectSuggestion(string suggestion)
    {
        SearchText = suggestion;
        ShowDropdown = false;
        Navigation.NavigateTo($"/jobs");
    }

    private void SearchJobs()
    {
        Navigation.NavigateTo($"/jobs");
    }
}