@page "/"
<PageTitle>Home - Punjab Jobs Online</PageTitle>

<!-- Hero Section -->
<div style="
    background: 
        linear-gradient(135deg, 
            rgba(144,200,144,0.6) 0%, 
            rgba(200,230,200,0.4) 40%, 
            rgba(240,245,240,0.5) 70%, 
            rgba(220,235,220,0.4) 100%);
    background-color: #dceadc;
    min-height: 450px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    padding: 40px 20px;
    position: relative;
    overflow: hidden;">

    <!-- Geometric shapes background -->
    <div style="
        position:absolute; top:0; left:0; 
        width:100%; height:100%; 
        opacity:0.15;
        background-image: 
            polygon(0 0, 50% 100%, 100% 0);
        background: 
            repeating-linear-gradient(
                45deg,
                transparent,
                transparent 40px,
                rgba(100,150,100,0.3) 40px,
                rgba(100,150,100,0.3) 80px
            );
        z-index:0;">
    </div>
<!-- Heading -->
    <h1 style="
        color: #1a5c1a;
        font-weight: bold;
        font-size: 32px;
        text-align: center;
        margin-bottom: 30px;
        position: relative;
        z-index: 1;">
        Search &amp; Apply Online on All Jobs
    </h1>

    
    <!-- Search Bar -->
    <div style="
        background-color: rgba(100,160,100,0.75);
        padding: 20px;
        border-radius: 4px;
        width: 100%;
        max-width: 900px;
        position: relative;
        z-index: 1;">
        <div class="row g-2">
            <div class="col-md-5">
                <input type="text" class="form-control"
                       placeholder="Looking for..."
                       style="border-radius:3px; height:42px;" />
            </div>
            <div class="col-md-3">
                <select class="form-select" style="height:42px; border-radius:3px;">
                    <option>Departments</option>
                    <option>Education</option>
                    <option>Health</option>
                    <option>Finance</option>
                    <option>IT</option>
                </select>
            </div>
            <div class="col-md-3">
                <select class="form-select" style="height:42px; border-radius:3px;">
                    <option>Location</option>
                    <option>Lahore</option>
                    <option>Karachi</option>
                    <option>Islamabad</option>
                    <option>Peshawar</option>
                </select>
            </div>
            <div class="col-md-1">
                <button class="btn btn-dark w-100" style="height:42px;">🔍</button>
            </div>
        </div>
    </div>
</div>

<!-- Carousel Section below hero -->
<div id="heroCarousel" class="carousel slide" data-bs-ride="carousel">
    <div class="carousel-indicators">
        <button type="button" data-bs-target="#heroCarousel" data-bs-slide-to="0" class="active"></button>
        <button type="button" data-bs-target="#heroCarousel" data-bs-slide-to="1"></button>
        <button type="button" data-bs-target="#heroCarousel" data-bs-slide-to="2"></button>
    </div>
    <div class="carousel-inner">
        <div class="carousel-item active">
            <div style="background:#f0f7f0; height:200px; display:flex; align-items:center; justify-content:center;">
                <h3 style="color:#2d7a2d;">Professional Identification</h3>
            </div>
        </div>
        <div class="carousel-item">
            <div style="background:#e8f4e8; height:200px; display:flex; align-items:center; justify-content:center;">
                <h3 style="color:#2d7a2d;">Discover Govt Punjab Jobs</h3>
            </div>
        </div>
        <div class="carousel-item">
            <div style="background:#f5faf5; height:200px; display:flex; align-items:center; justify-content:center;">
                <h3 style="color:#2d7a2d;">Apply on the GO</h3>
            </div>
        </div>
    </div>
    <button class="carousel-control-prev" type="button" data-bs-target="#heroCarousel" data-bs-slide="prev">
        <span class="carousel-control-prev-icon"></span>
    </button>
    <button class="carousel-control-next" type="button" data-bs-target="#heroCarousel" data-bs-slide="next">
        <span class="carousel-control-next-icon"></span>
    </button>
</div>