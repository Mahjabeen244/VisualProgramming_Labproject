@page "/"
<PageTitle>Home - Punjab Jobs Online</PageTitle>

<style>
    .hero-wrapper {
        position: relative;
        width: 100vw;
        margin-left: calc(-50vw + 50%);
        min-height: 450px;
        overflow: hidden;
    }

    .slides-container {
        display: flex;
        width: 300%;
        height: 450px;
        animation: slideMove 12s infinite;
    }

    .slide {
        width: 33.33%;
        height: 100%;
        flex-shrink: 0;
        position: relative;
    }

    /* Slide 1 - Triangle Pattern */
     .slide-1 {
        background: linear-gradient(135deg, 
            #e8f5e8 0%, 
            #c8e6c0 20%, 
            #dcedc8 40%, 
            #c5e1a5 60%, 
            #dcedc8 80%, 
            #e8f5e8 100%);
    }

    /* Slide 2 - Light plain green */
    .slide-2 {
        background: linear-gradient(160deg, #d4ecd4 0%, #e8f5e8 50%, #f0faf0 100%);
    }

    /* Slide 3 - Light with illustration */
    .slide-3 {
        background: linear-gradient(160deg, #e0f0e0 0%, #f0f8f0 60%, #f8fdf8 100%);
        display: flex;
        align-items: flex-end;
        justify-content: flex-end;
        padding-right: 80px;
        padding-bottom: 40px;
    }

    /* Laptop CSS */
    .illustration {
        display: flex;
        align-items: flex-end;
        gap: 20px;
    }

    .laptop-wrap {
        display: flex;
        flex-direction: column;
        align-items: center;
    }

    .laptop-screen {
        width: 180px;
        height: 110px;
        background: #222;
        border-radius: 8px 8px 0 0;
        border: 5px solid #333;
        padding: 5px;
    }

    .laptop-screen-inner {
        width: 100%;
        height: 100%;
        background: linear-gradient(180deg, #1a6bbf 35%, #fff 35%);
        border-radius: 2px;
    }

    .laptop-base {
        width: 200px;
        height: 10px;
        background: #444;
        border-radius: 0 0 5px 5px;
    }

    .bars {
        display: flex;
        align-items: flex-end;
        gap: 6px;
        margin-bottom: 10px;
    }

    .bar {
        width: 22px;
        border-radius: 3px 3px 0 0;
    }

    .bar1 { height: 80px; background: #e74c3c; }
    .bar2 { height: 55px; background: #f39c12; }
    .bar3 { height: 95px; background: #3498db; }
    .bar4 { height: 65px; background: #e74c3c; }

    .cup {
        width: 30px;
        height: 28px;
        background: #7B4F2E;
        border-radius: 0 0 8px 8px;
        border: 3px solid #5c3920;
        margin-bottom: 10px;
    }

    @@keyframes slideMove {
        0%   { transform: translateX(0); }
        28%  { transform: translateX(0); }
        33%  { transform: translateX(-33.33%); }
        61%  { transform: translateX(-33.33%); }
        66%  { transform: translateX(-66.66%); }
        94%  { transform: translateX(-66.66%); }
        99%  { transform: translateX(0); }
        100% { transform: translateX(0); }
    }

    .hero-content {
        position: absolute;
        top: 0; left: 0;
        width: 100%;
        height: 100%;
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        z-index: 10;
        padding: 20px;
    }
</style>

<div class="hero-wrapper">

    <!-- Sliding Backgrounds -->
    <div class="slides-container">

        <!-- Slide 1: Triangle Pattern -->
        <div class="slide slide-1"></div>

        <!-- Slide 2: Plain Light Green -->
        <div class="slide slide-2"></div>

        <!-- Slide 3: Illustration -->
        <div class="slide slide-3">
            <div class="illustration">
                <div class="bars">
                    <div class="bar bar1"></div>
                    <div class="bar bar2"></div>
                    <div class="bar bar3"></div>
                    <div class="bar bar4"></div>
                </div>
                <div class="laptop-wrap">
                    <div class="laptop-screen">
                        <div class="laptop-screen-inner"></div>
                    </div>
                    <div class="laptop-base"></div>
                </div>
                <div class="cup"></div>
            </div>
        </div>

    </div>

    <!-- Content Always On Top -->
    <div class="hero-content">
        <h1 style="
            color: #1a5c1a;
            font-weight: bold;
            font-size: 34px;
            text-align: center;
            margin-bottom: 35px;">
            Search &amp; Apply Online on All Jobs
        </h1>

        <div style="
            background-color: rgba(80,140,80,0.75);
            padding: 18px 20px;
            border-radius: 4px;
            width: 90%;
            max-width: 950px;">
            <div class="row g-2 align-items-center">
                <div class="col-md-5">
                    <input type="text" class="form-control"
                           placeholder="Looking for..."
                           style="height:42px; border-radius:3px;" />
                </div>
                <div class="col-md-3">
                    <select class="form-select" style="height:42px; border-radius:3px;">
                        <option>Departments</option>
                        <option>Education</option>
                        <option>Health</option>
                        <option>Finance</option>
                        <option>IT</option>
                    </select>
                </div>
                <div class="col-md-3">
                    <select class="form-select" style="height:42px; border-radius:3px;">
                        <option>Location</option>
                        <option>Lahore</option>
                        <option>Karachi</option>
                        <option>Islamabad</option>
                        <option>Peshawar</option>
                    </select>
                </div>
                <div class="col-md-1">
                    <button class="btn btn-dark w-100" style="height:42px;">🔍</button>
                </div>
            </div>
        </div>
    </div>

</div>