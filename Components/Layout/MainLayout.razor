@inherits LayoutComponentBase

<!-- Top Green Bar -->
<div style="background-color:#2d7a2d; padding:8px 20px; text-align:right;">
    <a href="/register" style="color:white; margin-right:15px; text-decoration:none;">
        REGISTER
    </a>
    <a href="/login" style="color:white; margin-right:15px; text-decoration:none;">
        🔑 LOGIN
