                    <span style="color: #4caf50; font-size: 24px; font-weight: 800; margin-left: 4px;">J</span>
                    <span style="background: #4caf50; color: #1e2530; border-radius: 50%; width: 22px; height: 22px; display: inline-flex; align-items: center; justify-content: center; font-size: 16px; font-weight: 900;">o</span>
                    <span style="color: white; font-size: 24px; font-weight: 800;">bs</span>
                </div>
                <span style="color: #8da2bb; font-size: 12px; display: block; font-style: italic; margin-top: -4px; padding-left: 2px;">online</span>
            </div>

            <div style="flex: 1; min-width: 180px;">
                <h6 style="font-weight: 700; font-size: 15px; margin: 0 0 10px 0; color: white; letter-spacing: 0.3px;">Sitemap</h6>
                <div style="width: 35px; height: 3px; background: #00bcd4; margin-bottom: 20px; border-radius: 2px;"></div>
                <div style="display: flex; flex-direction: column; gap: 12px; font-size: 13.5px;">
                    <a href="/" style="color: #b0c4de; text-decoration: none; transition: color 0.2s;" onmouseover="this.style.color='#ffffff'" onmouseout="this.style.color='#b0c4de'">Home</a>
                    <a href="/jobs" style="color: #b0c4de; text-decoration: none; transition: color 0.2s;" onmouseover="this.style.color='#ffffff'" onmouseout="this.style.color='#b0c4de'">Jobs</a>
                    <a href="/faq" style="color: #b0c4de; text-decoration: none; transition: color 0.2s;" onmouseover="this.style.color='#ffffff'" onmouseout="this.style.color='#b0c4de'">FAQ's</a>
                    <a href="/departments" style="color: #b0c4de; text-decoration: none; transition: color 0.2s;" onmouseover="this.style.color='#ffffff'" onmouseout="this.style.color='#b0c4de'">Departmental Contacts</a>
                </div>
            </div>

            <div style="flex: 1; min-width: 180px;">
                <h6 style="font-weight: 700; font-size: 15px; margin: 0 0 10px 0; color: white; letter-spacing: 0.3px;">Career Center</h6>
                <div style="width: 35px; height: 3px; background: #00bcd4; margin-bottom: 20px; border-radius: 2px;"></div>
                <div style="display: flex; flex-direction: column; gap: 12px; font-size: 13.5px;">
                    <a href="/career/interview-guides" style="color: #b0c4de; text-decoration: none; transition: color 0.2s;" onmouseover="this.style.color='#ffffff'" onmouseout="this.style.color='#b0c4de'">Interview Guides</a>
                    <a href="/career/search-guides" style="color: #b0c4de; text-decoration: none; transition: color 0.2s;" onmouseover="this.style.color='#ffffff'" onmouseout="this.style.color='#b0c4de'">Job Search Guides</a>
                    <a href="/career/development" style="color: #b0c4de; text-decoration: none; transition: color 0.2s;" onmouseover="this.style.color='#ffffff'" onmouseout="this.style.color='#b0c4de'">Career Development</a>
                    <a href="/career/news" style="color: #b0c4de; text-decoration: none; transition: color 0.2s;" onmouseover="this.style.color='#ffffff'" onmouseout="this.style.color='#b0c4de'">Career News</a>
                </div>
            </div>

            <div style="flex: 1; min-width: 220px;">
                <h6 style="font-weight: 700; font-size: 15px; margin: 0 0 10px 0; color: white; letter-spacing: 0.3px;">Contact Us</h6>
                <div style="width: 35px; height: 3px; background: #00bcd4; margin-bottom: 20px; border-radius: 2px;"></div>
                <div style="display: flex; gap: 10px; margin-bottom: 20px;">
                    <a href="https://facebook.com" target="_blank" rel="noopener noreferrer" style="background: #3b5998; color: white; width: 34px; height: 34px; border-radius: 50%; display: inline-flex; align-items: center; justify-content: center; text-decoration: none; font-weight: bold; transition: opacity 0.2s; font-size: 15px;" onmouseover="this.style.opacity='0.85'" onmouseout="this.style.opacity='1'">f</a>
                    <a href="https://x.com" target="_blank" rel="noopener noreferrer" style="background: #1da1f2; color: white; width: 34px; height: 34px; border-radius: 50%; display: inline-flex; align-items: center; justify-content: center; text-decoration: none; font-weight: bold; transition: opacity 0.2s; font-size: 14px;" onmouseover="this.style.opacity='0.85'" onmouseout="this.style.opacity='1'">t</a>
                </div>
                <div style="font-size: 13.5px; color: #b0c4de; display: flex; flex-direction: column; gap: 10px;">
                    <div style="display: flex; align-items: center; gap: 6px;">
                        <span>📞</span>
                        <a href="tel:+924235880062" style="color: #b0c4de; text-decoration: none;" onmouseover="this.style.color='#ffffff'" onmouseout="this.style.color='#b0c4de'">+92 42 35880062 Ext:1222</a>
                    </div>
                    <div style="display: flex; align-items: center; gap: 6px;">
                        <span>✉️</span>
                        <a href="mailto:jobsonlinesupport@punjab.gov.pk" style="color: #b0c4de; text-decoration: none; word-break: break-all;" onmouseover="this.style.color='#ffffff'" onmouseout="this.style.color='#b0c4de'">jobsonlinesupport@punjab.gov.pk</a>
                    </div>
                </div>
            </div>

        </div>

        <hr style="border: none; border-top: 1px solid rgba(255, 255, 255, 0.08); margin: 35px 0 20px 0;" />
        
        <p style="text-align: center; color: #697c92; font-size: 12.5px; margin: 0; font-weight: 500;">
            © 2026 Punjab Jobs Online. All rights reserved.
        </p>
    </div>
</footer>
@code {
    private string GetNavStyle(string page)
    {
        var path = Navigation.ToBaseRelativePath(Navigation.Uri).ToLower().TrimEnd('/');
        bool active = page == "" ? path == "" : path.StartsWith(page);
        return active
            ? "font-size:13px; color:#1a6bbf; border-bottom:2px solid #1a6bbf;"
            : "font-size:13px; color:#736e6e;";
    }

    protected override void OnInitialized()
    {
        Navigation.LocationChanged += (s, e) => StateHasChanged();
    }
}