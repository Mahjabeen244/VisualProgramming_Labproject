                    <a class="nav-link fw-bold" href="/faq" style="@GetNavStyle("faq")">FAQ'S</a>
                </li>
            </ul>
        </div>
    </div>
</nav>

<main>
    <article>
        @Body
    </article>
</main>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>
<footer style="background: #1e2530; color: white; padding: 50px 20px 25px 20px; width: 100vw; margin-left: calc(-50vw + 50%); position: relative; z-index: 10; font-family: system-ui, -apple-system, sans-serif;">
    <div style="max-width: 1200px; margin: 0 auto; padding: 0 15px;">
        <div style="display: flex; flex-wrap: wrap; gap: 40px; justify-content: space-between;">
            
