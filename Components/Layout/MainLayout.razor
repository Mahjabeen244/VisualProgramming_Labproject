@code {
    private string GetNavStyle(string page)
    {
        var path = Navigation.ToBaseRelativePath(Navigation.Uri).ToLower().TrimEnd('/');
        bool active = page == "" ? path == "" : path.StartsWith(page);
        return active
            ? "font-size:13px; color:#1a6bbf; border-bottom:2px solid #1a6bbf;"
            : "font-size:13px; color:#736e6e;";
    }

    protected override void OnInitialized()
    {
        Navigation.LocationChanged += (s, e) => StateHasChanged();
    }
}