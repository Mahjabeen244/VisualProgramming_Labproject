@inherits LayoutComponentBase
@inject NavigationManager Navigation

<div style="background-color:#2d7a2d; padding:4px 20px; text-align:right;">
    <a href="/register" style="color:white; margin-right:12px; text-decoration:none; font-size:11px; letter-spacing:1px;">REGISTER</a>
    <a href="/login" style="color:white; margin-right:12px; text-decoration:none; font-size:11px; letter-spacing:1px;">🔑 LOGIN</a>
    <a href="/member-login" style="color:white; text-decoration:none; font-size:11px; letter-spacing:1px;">🔑 MEMBER LOGIN</a>
</div>

<nav class="navbar navbar-expand-lg navbar-light bg-white shadow-sm py-2">
    <div class="container">
        <a class="navbar-brand" href="/">
            <span style="color:#2d7a2d; font-size:22px; font-weight:bold; font-family:Arial;">Punjab</span>
            <span style="color:#2d7a2d; font-size:22px; font-weight:bold;"> J</span>
            <span style="background-color:#2d7a2d; color:white; border-radius:50%; padding:1px 7px; font-size:18px; font-weight:bold;">o</span>
            <span style="color:#333; font-size:22px; font-weight:bold;">bs</span>
            <span style="color:#888; font-size:11px; display:block; margin-top:-6px; margin-left:58px; font-style:italic;">online</span>
        </a>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
            <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse justify-content-end" id="navbarNav">
            <ul class="navbar-nav gap-4">
                <li class="nav-item">
                    <a class="nav-link fw-bold" href="/" style="@GetNavStyle("")">HOME</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link fw-bold" href="/jobs" style="@GetNavStyle("jobs")">JOBS</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link fw-bold" href="/departments" style="@GetNavStyle("departments")">DEPARTMENTAL CONTACTS</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link fw-bold" href="/faq" style="@GetNavStyle("faq")">FAQ'S</a>
                </li>
            </ul>
        </div>
    </div>
</nav>

<main>
    <article>
        @Body
    </article>
</main>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    private string GetNavStyle(string page)
    {
        var path = Navigation.ToBaseRelativePath(Navigation.Uri).ToLower().TrimEnd('/');
        bool active = page == "" ? path == "" : path.StartsWith(page);
        return active
            ? "font-size:13px; color:#1a6bbf; border-bottom:2px solid #1a6bbf;"
            : "font-size:13px; color:#736e6e;";
    }

    protected override void OnInitialized()
    {
        Navigation.LocationChanged += (s, e) => StateHasChanged();
    }
}