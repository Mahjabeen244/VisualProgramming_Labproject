@inject NavigationManager Navigation

<ul class="navbar-nav gap-4">
    <li class="nav-item">
        <NavLink class="nav-link fw-bold" href="" Match="NavLinkMatch.All"
                 style="@(IsActive("") ? "color:#1a6bbf; border-bottom: 2px solid #1a6bbf;" : "color:#736e6e;") font-size:13px;">HOME</NavLink>
    </li>
    <li class="nav-item">
        <NavLink class="nav-link fw-bold" href="jobs" Match="NavLinkMatch.Prefix"
                 style="@(IsActive("jobs") ? "color:#1a6bbf; border-bottom: 2px solid #1a6bbf;" : "color:#736e6e;") font-size:13px;">JOBS</NavLink>
    </li>
    <li class="nav-item">
        <NavLink class="nav-link fw-bold" href="departments" Match="NavLinkMatch.Prefix"
                 style="@(IsActive("departments") ? "color:#1a6bbf; border-bottom: 2px solid #1a6bbf;" : "color:#7d7575;") font-size:13px;">DEPARTMENTAL CONTACTS</NavLink>
    </li>
    <li class="nav-item">
        <NavLink class="nav-link fw-bold" href="faq" Match="NavLinkMatch.Prefix"
                 style="@(IsActive("faq") ? "color:#1a6bbf; border-bottom: 2px solid #1a6bbf;" : "color:#736e6e;") font-size:13px;">FAQ'S</NavLink>
    </li>
</ul>

@code {
    // This helper method checks if the current browser address matches the link path
    private bool IsActive(string href)
    {
        var relativePath = Navigation.ToBaseRelativePath(Navigation.Uri).ToLower();
        
        if (string.IsNullOrEmpty(href))
        {
            return string.IsNullOrEmpty(relativePath) || relativePath.StartsWith("? ");
        }
        
        return relativePath.StartsWith(href.ToLower());
    }

    protected override void OnInitialized()
    {
        // Re-renders the navbar layout cleanly during tab transitions
        Navigation.LocationChanged += (s, e) => StateHasChanged();
    }
}