@inject NavigationManager Navigation

<ul class="navbar-nav gap-4">
    <li class="nav-item">
        <NavLink class="nav-link fw-bold" href="" Match="NavLinkMatch.All"
                 style="@GetHomeStyle()">HOME</NavLink>
    </li>
    <li class="nav-item">
        <NavLink class="nav-link fw-bold" href="jobs" Match="NavLinkMatch.Prefix"
                 style="@GetJobsStyle()">JOBS</NavLink>
    </li>
    <li class="nav-item">
        <NavLink class="nav-link fw-bold" href="departments" Match="NavLinkMatch.Prefix"
                 style="@GetDeptStyle()">DEPARTMENTAL CONTACTS</NavLink>
    </li>
    <li class="nav-item">
        <NavLink class="nav-link fw-bold" href="faq" Match="NavLinkMatch.Prefix"
                 style="@GetFaqStyle()">FAQ'S</NavLink>
    </li>
</ul>

@code {
    // These 4 small methods completely clean up the HTML style strings to make the compiler happy
    private string GetHomeStyle() => IsActive("") 
        ? "font-size:13px; color:#1a6bbf; border-bottom: 2px solid #1a6bbf;" 
        : "font-size:13px; color:#736e6e;";

    private string GetJobsStyle() => IsActive("jobs") 
        ? "font-size:13px; color:#1a6bbf; border-bottom: 2px solid #1a6bbf;" 
        : "font-size:13px; color:#736e6e;";

    private string GetDeptStyle() => IsActive("departments") 
        ? "font-size:13px; color:#1a6bbf; border-bottom: 2px solid #1a6bbf;" 
        : "font-size:13px; color:#7d7575;";

    private string GetFaqStyle() => IsActive("faq") 
        ? "font-size:13px; color:#1a6bbf; border-bottom: 2px solid #1a6bbf;" 
        : "font-size:13px; color:#736e6e;";

    private bool IsActive(string href)
    {
        var relativePath = Navigation.ToBaseRelativePath(Navigation.Uri).ToLower();
        
        if (string.IsNullOrEmpty(href))
        {
            return string.IsNullOrEmpty(relativePath) || relativePath.StartsWith("?");
        }
        
        return relativePath.StartsWith(href.ToLower());
    }

    protected override void OnInitialized()
    {
        Navigation.LocationChanged += (s, e) => StateHasChanged();
    }
}
}